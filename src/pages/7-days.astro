---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { readFileSync } from 'node:fs';

const title = "Hermes Agent 教程：7 天入门路径 — hermes101";
const description = "从安装到自动化，7 天跟练计划。每天一个可验证成果，所有命令均经官网核对。";
const schema = {"@context": "https://schema.org", "@type": "ItemList", "name": "Hermes Agent 7 天入门路径", "description": description, "numberOfItems": 7};

const pageContent = readFileSync('/root/hermes101-site/src/content/7-days-index.html', 'utf-8');
---

<Layout title={title} description={description} schema={schema}>
  <Nav />
  <main class="pt-28 pb-24 min-h-screen">
    <Fragment set:html={pageContent} />
  </main>
  <Footer />
</Layout>
