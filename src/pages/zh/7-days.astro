---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';

const title = "Hermes Agent 教程：7 天入门路径 — hermes101";
const description = "Hermes Agent 7 天中文跟练计划，从安装、模型配置、消息网关、工具调用、Skills、记忆系统到定时任务自动化，每天一个可验证成果，并配套官网核对命令、截图式检查点、常见错误解释和下一步练习。";
const schema = {"@context": "https://schema.org", "@type": "ItemList", "name": "Hermes Agent 7 天入门路径", "description": description, "numberOfItems": 7};

const pageContent = readFileSync(path.resolve(process.cwd(), 'src/content', '7-days-index.html'), 'utf-8');
---

<Layout lang="zh-CN" canonicalPath="/zh/7-days/" title={title} description={description} schema={schema}>
  <Nav lang="zh-CN" />
  <main class="pt-28 pb-24 min-h-screen">
    <Fragment set:html={pageContent} />
  </main>
  <Footer lang="zh-CN" />
</Layout>
