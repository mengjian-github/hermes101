---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';

const title = "Hermes Agent 常见问题 FAQ — hermes101";
const description = "安装失败、WSL2 报错、API key 配置、飞书/Telegram 不回复、v0.10 新功能等高频问题速查。";
const schema = {"@context": "https://schema.org", "@type": "FAQPage", "name": "Hermes Agent 常见问题 FAQ — hermes101", "description": "安装失败、WSL2 报错、API key 配置、飞书/Telegram 不回复、v0.10 新功能等高频问题速查。"};

const pageContent = readFileSync(path.resolve(process.cwd(), 'src/content', 'faq-content.html'), 'utf-8');
---

<Layout lang="zh-CN" canonicalPath="/zh/faq/" title={title} description={description} schema={schema}>
  <Nav lang="zh-CN" />
  <main class="pt-28 pb-24 min-h-screen">
    <Fragment set:html={pageContent} />
  </main>
  <Footer lang="zh-CN" />
</Layout>
