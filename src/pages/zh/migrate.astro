---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';

const title = "OpenClaw 迁移 Hermes 完整指南 — hermes101";
const description = "使用 hermes claw migrate 一键迁移。附 0.9 功能对照表、检查清单、常见失败修复、迁移后验证。";
const schema = {"@context": "https://schema.org", "@type": "HowTo", "name": "OpenClaw 迁移 Hermes 完整指南 — hermes101", "description": "使用 hermes claw migrate 一键迁移。附 0.9 功能对照表、检查清单、常见失败修复、迁移后验证。"};

const pageContent = readFileSync(path.resolve(process.cwd(), 'src/content', 'migrate-content.html'), 'utf-8');
---

<Layout lang="zh-CN" canonicalPath="/zh/migrate/" title={title} description={description} schema={schema}>
  <Nav lang="zh-CN" />
  <main class="pt-28 pb-24 min-h-screen">
    <Fragment set:html={pageContent} />
  </main>
  <Footer lang="zh-CN" />
  <script>
    document.querySelectorAll('.trouble-header').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var body = this.nextElementSibling;
        var arrow = this.querySelector('.trouble-arrow');
        if (body) {
          body.classList.toggle('hidden');
          if (arrow) arrow.style.transform = body.classList.contains('hidden') ? '' : 'rotate(180deg)';
        }
      });
    });
    var checkItems = document.querySelectorAll('.check-item');
    function updateCounts() {
      var preCount = document.getElementById('pre-count');
      var postCount = document.getElementById('post-count');
      if (preCount) {
        var c1 = document.querySelectorAll('#pre-checklist .check-box.checked').length;
        var t1 = document.querySelectorAll('#pre-checklist .check-item').length;
        preCount.textContent = c1 + ' / ' + t1;
      }
      if (postCount) {
        var c2 = document.querySelectorAll('#post-checklist .check-box.checked').length;
        var t2 = document.querySelectorAll('#post-checklist .check-item').length;
        postCount.textContent = c2 + ' / ' + t2;
      }
    }
    checkItems.forEach(function(item) {
      item.addEventListener('click', function() {
        var box = this.querySelector('.check-box');
        var text = this.querySelector('.check-text');
        if (box) {
          box.classList.toggle('checked');
          if (box.classList.contains('checked')) {
            box.innerHTML = '✓';
            box.style.background = '#51ffb4';
            box.style.borderColor = '#51ffb4';
            box.style.color = '#000';
            if (text) text.style.textDecoration = 'line-through';
          } else {
            box.innerHTML = '';
            box.style.background = '';
            box.style.borderColor = '';
            box.style.color = '';
            if (text) text.style.textDecoration = '';
          }
          updateCounts();
        }
      });
    });
  </script>
</Layout>
