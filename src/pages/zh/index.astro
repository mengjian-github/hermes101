---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const title = "Hermes Agent 小白入门第一站 — hermes101";
const description = "Hermes Agent 中文入门教程：从 5 分钟安装开始，按 7 天跟练路径完成模型 Provider、API Key、工具调用、记忆、Skills、消息网关、定时任务和 OpenClaw 迁移验证，适合第一次上手的 AI Agent 用户快速跑通真实工作流。";
const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "hermes101",
  "url": "https://hermes101.dev",
  "description": description
};

const features = [
  { icon: "psychology", title: "智能记忆", desc: "跨 session 记忆，越用越懂你。上下文持续积累，对话更高效。" },
  { icon: "hub", title: "22+ 平台", desc: "Telegram / Discord / 飞书 / Slack / WhatsApp / GitHub / 企业微信……" },
  { icon: "groups", title: "多 Agent 协作", desc: "Profile 隔离，独立 bot token，多 agent 各司其职。" },
  { icon: "update", title: "定时自动化", desc: "自然语言创建 cron，自动投递到任意平台，解放双手。" },
  { icon: "extension", title: "MCP 生态", desc: "100+ 技能包，一键安装。搜索、代码、文件、网络……应有尽有。" },
  { icon: "gpp_good", title: "安全沙箱", desc: "危险命令审批流程，容器隔离执行，安心使用无风险。" },
  { icon: "model_training", title: "多模型", desc: "OpenAI / Claude / GLM / Kimi / MiniMax / Ollama……灵活切换。" },
  { icon: "speed", title: "并行执行", desc: "多 subagent 并发执行，后台进程实时监控，效率倍增。" },
  { icon: "cloud_done", title: "随处部署", desc: "Linux / Mac / WSL2 / Termux / Cloud / Server，到处能跑。" },
];

const days = [
  { day: 1, title: "安装与配置", desc: "一键安装 + API Key 配置", icon: "rocket_launch" },
  { day: 2, title: "第一次对话", desc: "模型选择 + 基础交互", icon: "terminal" },
  { day: 3, title: "接入平台", desc: "Telegram / Discord 接入", icon: "hub" },
  { day: 4, title: "MCP 技能", desc: "安装第一个技能包", icon: "memory" },
  { day: 5, title: "自动化", desc: "定时任务 + 工作流", icon: "update" },
  { day: 6, title: "多 Agent", desc: "Profile 隔离 + 多 bot", icon: "groups" },
  { day: 7, title: "上线运维", desc: "持久化 + 监控 + 备份", icon: "cloud_done" },
];
---
<Layout hasAlternate={true} lang="zh-CN" canonicalPath="/zh/" title={title} description={description} schema={schema}>
  <Nav lang="zh-CN" />
  <main class="pt-20">
    <!-- ====== Hero Section ====== -->
    <section class="max-w-6xl mx-auto px-6 pt-16 pb-24 relative">
      <!-- Hero Background Image -->
      <div class="absolute inset-0 -z-10 opacity-30 overflow-hidden rounded-3xl">
        <img src="/images/hero.png" alt="Hermes Agent 终端安装与配置预览" class="w-full h-full object-cover" loading="eager" fetchpriority="high" width="1376" height="768" />
        <div class="absolute inset-0 bg-gradient-to-b from-[#0A0A0F]/60 via-[#0A0A0F]/80 to-[#0A0A0F]"></div>
      </div>
      <div class="flex flex-col items-center text-center mb-16">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-white/[0.1] bg-[#1b1b20] mb-8">
          <span class="w-2 h-2 rounded-full bg-[#18E299] animate-pulse"></span>
          <span class="text-xs font-bold tracking-widest text-white">开源 AI AGENT · 22+ 平台 · 100+ 技能</span>
        </div>

        <!-- Title -->
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold tracking-[-0.04em] mb-6">
          <span class="text-[#18E299]">AI编程助手</span><br/>
          <span class="text-white">从安装到上线</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-xl md:text-2xl text-white/90 font-medium max-w-2xl mb-12">
          5分钟安装，7天掌握。Hermes Agent 中文入门指南。
        </p>

        <!-- Disclaimer banner -->
        <div class="w-full max-w-3xl mb-8 px-4 py-3 rounded-lg border border-[#FFB962]/20 bg-[#FFB962]/5 text-[#FFB962] text-sm text-center">
          <span class="font-bold">声明：</span>本站为社区独立指南，非官方文档。请以 <a href="https://hermes-agent.nousresearch.com/docs" target="_blank" rel="noopener noreferrer" class="underline">官方 Hermes Agent 文档</a> 为准。
        </div>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 mb-16">
          <a href="/zh/setup/"
             data-track-event="install_cta_click"
             class="cta-primary px-10 py-4 text-lg">
            开始安装
          </a>
          <a href="/zh/7-days/"
             data-track-event="doc_nav_click"
             class="px-10 py-4 border-2 border-white/20 text-white rounded-full font-bold text-lg hover:bg-white/5 transition-all active:scale-95">
            查看文档
          </a>
          <a href="https://github.com/mengjian-github/hermes101" target="_blank" rel="noopener noreferrer"
             data-track-event="github_click"
             class="px-10 py-4 bg-[#1b1b20] border border-white/10 text-white rounded-full font-bold text-lg hover:border-[#18E299]/50 hover:text-[#18E299] transition-all active:scale-95 inline-flex items-center gap-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            GitHub
          </a>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 border-y border-white/[0.05] py-10 w-full max-w-4xl">
          <div class="flex flex-col items-center">
            <span class="text-4xl font-black text-white">105K+</span>
            <span class="text-sm font-bold text-white/60 tracking-widest uppercase mt-1">GitHub Stars</span>
          </div>
          <div class="flex flex-col items-center">
            <span class="text-4xl font-black text-white">22+</span>
            <span class="text-sm font-bold text-white/60 tracking-widest uppercase mt-1">接入平台</span>
          </div>
          <div class="flex flex-col items-center">
            <span class="text-4xl font-black text-white">v0.10</span>
            <span class="text-sm font-bold text-white/60 tracking-widest uppercase mt-1">稳定版</span>
          </div>
        </div>
      </div>

      <!-- Terminal Mockup -->
      <div class="relative max-w-5xl mx-auto">
        <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[120%] h-[120%] bg-[#18E299]/5 rounded-full blur-[120px] pointer-events-none"></div>
        <div class="bg-[#0E0E13] rounded-xl overflow-hidden border border-white/[0.05] terminal-glow relative z-10">
          <!-- Terminal Header -->
          <div class="bg-[#1b1b20] px-4 py-3 border-b border-white/[0.05] flex items-center justify-between">
            <div class="flex gap-2">
              <div class="w-3 h-3 rounded-full bg-[#ffb4ab]/30"></div>
              <div class="w-3 h-3 rounded-full bg-[#ffb962]/30"></div>
              <div class="w-3 h-3 rounded-full bg-[#18E299]/30"></div>
            </div>
            <div class="text-[10px] font-mono text-white/40 tracking-widest">BASH — HERMES_INSTALLER</div>
            <div class="w-12"></div>
          </div>
          <!-- Terminal Content -->
          <div class="p-6 md:p-8 font-mono text-sm md:text-base leading-relaxed">
            <div class="flex gap-4">
              <span class="text-white/40">1</span>
              <p class="text-white"><span class="text-[#18E299]">$</span> curl -fsSL https://raw.githubusercontent.com/NousResearch/hermes-agent/main/scripts/install.sh | bash</p>
            </div>
            <div class="flex gap-4 mt-2">
              <span class="text-white/40">2</span>
              <p class="text-[#4dffb3]">Checking environment dependencies... [OK]</p>
            </div>
            <div class="flex gap-4 mt-1">
              <span class="text-white/40">3</span>
              <p class="text-[#4dffb3]">Initializing Hermes AI Neural Engine...</p>
            </div>
            <div class="flex gap-4 mt-1">
              <span class="text-white/40">4</span>
              <p class="text-[#4dffb3]">Mounting 22+ cloud platforms... [SUCCESS]</p>
            </div>
            <div class="flex gap-4 mt-2">
              <span class="text-white/40">5</span>
              <p class="text-white"><span class="text-[#18E299]">$</span> hermes</p>
            </div>
            <div class="flex gap-4 mt-2">
              <span class="text-white/40">6</span>
              <div class="bg-[#18E299]/10 text-[#51ffb4] px-4 py-2 rounded-lg border border-[#18E299]/20 w-full">
                <p class="font-bold">🚀 Hermes Agent is now active.</p>
                <p class="text-sm">Ready to code from installation to production.</p>
              </div>
            </div>
            <div class="flex gap-4 mt-4">
              <span class="text-white/40">7</span>
              <p class="text-white"><span class="text-[#18E299]">$</span> <span class="animate-pulse">_</span></p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ====== 9 Core Features ====== -->
    <section class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <div class="text-center mb-14">
        <div class="inline-block px-4 py-1.5 rounded-full bg-[#1b1b20] border border-[#3b4a41]/10 text-[#18E299] text-[10px] font-black tracking-[0.2em] uppercase mb-6">
          Capabilities
        </div>
        <h2 class="text-3xl md:text-5xl font-black tracking-[-0.04em] text-white mb-4">9 大核心能力</h2>
        <div class="h-1 w-24 bg-gradient-to-r from-[#51ffb4] to-transparent mx-auto rounded-full shadow-[0_0_15px_rgba(81,255,180,0.5)]"></div>
        <p class="mt-8 text-[#bacbbe] max-w-2xl mx-auto text-lg">不只是一个聊天机器人，Hermes 是你的全能 AI 编程搭档。</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {features.map(f => (
          <div class="group bg-[#12121A] p-8 rounded-xl border border-[#3b4a41]/15 feature-card-glow transition-all duration-300">
            <div class="w-12 h-12 rounded-full bg-[#18E299]/10 flex items-center justify-center mb-6 border border-[#18E299]/20">
              <span class="material-symbols-outlined text-[#51ffb4]" style="font-variation-settings: 'FILL' 1;">{f.icon}</span>
            </div>
            <h3 class="text-xl font-bold text-white mb-3 tracking-tight">{f.title}</h3>
            <p class="text-[#bacbbe] text-sm leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>

      <!-- Bento promo -->
      <div class="mt-16 grid grid-cols-1 md:grid-cols-12 gap-6">
        <div class="md:col-span-8 bg-[#1b1b20] rounded-xl p-0 relative overflow-hidden group min-h-[220px]">
          <img src="/images/platforms.png" alt="多平台连接" class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:opacity-80 transition-opacity" loading="lazy" />
          <div class="absolute inset-0 bg-gradient-to-r from-[#1b1b20] via-[#1b1b20]/70 to-transparent"></div>
          <div class="relative z-10 p-10">
            <h3 class="text-2xl md:text-3xl font-black text-white mb-4">智能多平台部署</h3>
            <p class="text-white/80 max-w-md">支持 Linux / macOS / WSL2 / Termux / Cloud / Server，随处运行。</p>
          </div>
        </div>
        <div class="md:col-span-4 bg-[#18E299] rounded-xl p-10 flex flex-col justify-between relative overflow-hidden">
          <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-white/10 rounded-full blur-2xl"></div>
          <span class="material-symbols-outlined text-4xl text-white relative z-10" style="font-variation-settings: 'FILL' 1;">bolt</span>
          <div class="relative z-10">
            <h3 class="text-2xl md:text-3xl font-black text-white mb-2">极速响应</h3>
            <p class="text-white/90 font-bold">多模型并行推理，流式响应，工具调用零延迟。</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ====== 7-Day Path Preview ====== -->
    <section class="py-20 md:py-28 bg-[#131318]">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-14">
          <h2 class="text-3xl md:text-5xl font-black tracking-[-0.04em] text-white mb-4">7 天从零到上线</h2>
          <p class="text-lg text-[#bacbbe]">每天都有可验证的成果</p>
        </div>
        <!-- 7 Days Overview Image -->
        <div class="mb-12 rounded-2xl overflow-hidden border border-white/[0.06]">
          <img src="/images/7days.png" alt="7天学习路径总览" class="w-full object-cover max-h-[240px]" loading="lazy" />
        </div>

        <div class="flex gap-4 overflow-x-auto pb-4 snap-x snap-mandatory no-scrollbar" style="-webkit-overflow-scrolling: touch;">
          {days.map(d => (
            <a href={`/zh/7-days/day-${d.day}/`} class="flex-shrink-0 w-[200px] snap-start rounded-xl p-6 bg-[#1b1b20] border border-[#3b4a41]/15 transition-all duration-300 hover:-translate-y-1 hover:border-[#18E299]/30 group block">
              <div class="w-12 h-12 rounded-xl bg-[#18E299]/10 flex items-center justify-center text-[#51ffb4] mb-4 border border-[#18E299]/20 group-hover:bg-[#18E299] group-hover:text-[#003823] transition-all">
                <span class="material-symbols-outlined text-2xl" style="font-variation-settings: 'FILL' 1;">{d.icon}</span>
              </div>
              <span class="text-[#18E299] text-xs font-bold tracking-widest uppercase">Day {String(d.day).padStart(2, '0')}</span>
              <h3 class="font-bold text-white text-lg mt-1 mb-1.5">{d.title}</h3>
              <p class="text-[13px] text-[#bacbbe]">{d.desc}</p>
            </a>
          ))}
        </div>

        <div class="text-center mt-8">
          <a href="/zh/7-days/" class="inline-flex items-center gap-1.5 text-[15px] font-medium text-[#18E299] hover:text-[#51ffb4] transition-colors">
            查看完整 7 天路径 →
          </a>
        </div>
      </div>
    </section>

    <!-- ====== Migration Teaser ====== -->
    <section class="py-20 md:py-28">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <!-- Left text -->
          <div>
            <h2 class="text-3xl md:text-4xl font-black tracking-[-0.04em] text-white mb-6">从 OpenClaw 迁移？<br/><span class="text-[#18E299]">3 步搞定</span></h2>
            <p class="text-lg leading-relaxed text-[#bacbbe] mb-8">
              使用 <code class="text-[#18E299] font-mono px-2 py-0.5 bg-[#18E299]/5 rounded">hermes claw migrate</code> 一键迁移，配置不会丢。备份、导入、诊断一条龙。
            </p>
            <a href="/zh/migrate/" class="inline-flex items-center gap-1.5 text-[15px] font-medium text-[#18E299] hover:text-[#51ffb4] transition-colors">
              查看迁移指南 →
            </a>
          </div>

          <!-- Right terminal -->
          <div class="bg-[#0E0E13] rounded-xl overflow-hidden border border-white/[0.05] terminal-glow">
            <div class="bg-[#1b1b20] px-4 py-3 border-b border-white/[0.05] flex items-center gap-2">
              <div class="flex gap-1.5">
                <div class="w-2.5 h-2.5 rounded-full bg-[#ffb4ab]/40"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-[#ffb962]/40"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-[#18E299]/40"></div>
              </div>
              <span class="ml-4 text-[10px] font-mono text-white/40 tracking-widest">hermes-sh</span>
            </div>
            <div class="p-6 font-mono text-sm leading-relaxed">
              <p class="text-[#18E299]">➜ <span class="text-white">~</span> <span class="text-[#bacbbe]">hermes claw migrate --dry-run</span></p>
              <p class="text-[#bacbbe] mt-2">[INFO] Scanning for legacy OpenClaw instances...</p>
              <p class="text-[#bacbbe]">[INFO] Found 3 nodes. Starting data mapping...</p>
              <p class="text-[#bacbbe]">[PROGRESS] ██████████████████████ 100%</p>
              <p class="text-[#18E299] mt-3 font-bold">✔ SUCCESS: Migration completed in 1.2s</p>
              <p class="text-[#18E299] font-bold">✔ All configs migrated</p>
              <p class="text-[#18E299] font-bold">✔ All 3 agents imported</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ====== Final CTA ====== -->
    <section class="py-20 md:py-28 bg-[#131318]">
      <div class="max-w-6xl mx-auto px-6 text-center">
        <h2 class="text-3xl md:text-5xl font-black tracking-[-0.04em] text-white mb-4">准备好开始了吗？</h2>
        <p class="text-lg text-[#bacbbe] mb-10">5 分钟完成安装，立刻体验 AI Agent 的力量</p>
        <a href="/zh/setup/"
           class="cta-primary px-12 py-5 text-lg">
          开始安装 Hermes Agent
          <span class="material-symbols-outlined text-xl" style="font-variation-settings: 'FILL' 1;">arrow_forward</span>
        </a>
        <div class="mt-8 space-y-1">
          <p class="text-[13px] text-white/40">📌 基于 Hermes v0.10.x | 最后更新：2026-04-20</p>
          <p class="text-[13px] text-white/40">⚠️ 本站为社区独立指南，非官方文档</p>
        </div>
      </div>
    </section>
  </main>
  <Footer lang="zh-CN" />
</Layout>
