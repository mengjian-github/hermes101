---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';

const title = "Hermes Agent 优质教程资源整合 — hermes101";
const description = "Hermes Agent 资源导航，汇总官方文档、安装教程、中文入门指南、社区讨论、常见问题、进阶技巧、Skills 工作流参考、迁移教程、排错资料、视频文章和适合继续学习的外部链接，帮助新手从入门走到稳定使用。";
const schema = {"@context": "https://schema.org", "@type": "CollectionPage", "name": "Hermes Agent 优质教程资源整合 — hermes101", "description": "全网最全 Hermes Agent 教程资源汇总：官方文档、视频教程、中文指南、社区讨论、进阶技巧，一站式收藏。"};

const pageContent = readFileSync(path.resolve(process.cwd(), 'src/content', 'resources-content.html'), 'utf-8');
---

<Layout lang="zh-CN" canonicalPath="/zh/resources/" title={title} description={description} schema={schema}>
  <Nav lang="zh-CN" />
  <main class="pt-28 pb-24 min-h-screen">
    <Fragment set:html={pageContent} />
  </main>
  <Footer lang="zh-CN" />
</Layout>
