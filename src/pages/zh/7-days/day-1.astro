---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';

const title = "Day 1 — 安装 Hermes Agent | 7 天教程 — hermes101";
const description = "安装 Hermes Agent，运行第一次对话。支持 Mac、Linux、WSL2。";
const schema = {"@context": "https://schema.org", "@type": "LearningResource", "name": title, "description": description};

const pageContent = readFileSync(path.resolve(process.cwd(), 'src/content', '7-days-day-1.html'), 'utf-8');
---

<Layout lang="zh-CN" canonicalPath="/zh/7-days/day-1/" title={title} description={description} schema={schema}>
  <Nav lang="zh-CN" />
  <main class="pt-28 pb-24 min-h-screen">
    <Fragment set:html={pageContent} />
  </main>
  <Footer lang="zh-CN" />
</Layout>
