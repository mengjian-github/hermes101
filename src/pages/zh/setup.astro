---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';

const title = "安装 Hermes Agent — hermes101";
const description = "Hermes Agent 中文安装指南，覆盖 Linux、macOS、Windows WSL2、Termux 的官方安装命令、Shell 重载、Provider 配置、首次对话验证，以及 PATH、权限、Node、API Key、网络代理等常见安装失败和环境变量问题修复。";
const schema = {"@context": "https://schema.org", "@type": "HowTo", "name": "安装 Hermes Agent — hermes101", "description": "60 秒完成 Hermes Agent 安装。支持 Linux / macOS / Windows WSL2 / Termux，官方一键脚本。", "dateModified": "2026-07-09"};

const pageContent = readFileSync(path.resolve(process.cwd(), 'src/content', 'setup-content.html'), 'utf-8');
---

<Layout lang="zh-CN" canonicalPath="/zh/setup/" title={title} description={description} schema={schema}>
  <Nav lang="zh-CN" />
  <main class="pt-28 pb-24 min-h-screen">
    <Fragment set:html={pageContent} />
  </main>
  <Footer lang="zh-CN" />
</Layout>
