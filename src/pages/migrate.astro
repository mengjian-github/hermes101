---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { readFileSync } from 'node:fs';

const title = "OpenClaw 迁移 Hermes 完整指南 — hermes101";
const description = "使用 hermes claw migrate 一键迁移。附 0.9 功能对照表、检查清单、常见失败修复、迁移后验证。";
const schema = {"@context": "https://schema.org", "@type": "HowTo", "name": "OpenClaw 迁移 Hermes 完整指南 — hermes101", "description": "使用 hermes claw migrate 一键迁移。附 0.9 功能对照表、检查清单、常见失败修复、迁移后验证。"};

const pageContent = readFileSync('/root/hermes101-site/src/content/migrate-content.html', 'utf-8');
---

<Layout title={title} description={description} schema={schema}>
  <Nav />
  <main class="pt-28 pb-24 min-h-screen">
    <Fragment set:html={pageContent} />
  </main>
  <Footer />
  <script is:inline>
    (function() {
      // Accordion toggle
      document.querySelectorAll('.trouble-header').forEach(btn => {
        btn.addEventListener('click', function() {
          const body = this.nextElementSibling;
          const arrow = this.querySelector('.trouble-arrow');
          if (body) {
            body.classList.toggle('hidden');
            if (arrow) arrow.style.transform = body.classList.contains('hidden') ? '' : 'rotate(180deg)';
          }
        });
      });
      // Checklist
      const checkItems = document.querySelectorAll('.check-item');
      const postCount = document.getElementById('post-count');
      function updateCount() {
        const checked = document.querySelectorAll('.check-box.checked').length;
        if (postCount) postCount.textContent = checked + ' / ' + checkItems.length;
      }
      checkItems.forEach(item => {
        item.addEventListener('click', function() {
          const box = this.querySelector('.check-box');
          const text = this.querySelector('.check-text');
          if (box) {
            box.classList.toggle('checked');
            if (box.classList.contains('checked')) {
              box.innerHTML = '✓';
              box.style.background = '#51ffb4';
              box.style.borderColor = '#51ffb4';
              box.style.color = '#000';
              if (text) text.style.textDecoration = 'line-through';
            } else {
              box.innerHTML = '';
              box.style.background = '';
              box.style.borderColor = '';
              box.style.color = '';
              if (text) text.style.textDecoration = '';
            }
            updateCount();
          }
        });
      });
    })();
  </script>
</Layout>
