---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = "Hermes Agent 101 — English-first beginner guide";
const description = "A practical English starting point for Hermes Agent: install it, understand the CLI, connect tools and channels, then continue with the Chinese deep-dive guide when needed.";
const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Hermes Agent 101",
  "url": "https://hermes101.dev",
  "inLanguage": "en",
  "description": description,
  "potentialAction": {
    "@type": "ReadAction",
    "target": "https://hermes-agent.nousresearch.com/docs"
  }
};

const quickStart = [
  { step: "01", title: "Install", desc: "Use the official Hermes Agent docs as the source of truth before running local commands.", href: "https://hermes-agent.nousresearch.com/docs" },
  { step: "02", title: "Configure", desc: "Set your provider, model, profiles, tools, and gateway surfaces from a single Hermes setup.", href: "https://hermes-agent.nousresearch.com/docs" },
  { step: "03", title: "Operate", desc: "Run the CLI, connect browser or messaging channels, and automate recurring work with skills and cron jobs.", href: "https://hermes-agent.nousresearch.com/docs" },
];

const paths = [
  { title: "Chinese setup guide", desc: "The existing step-by-step Chinese install guide has moved under /zh/.", href: "/zh/setup" },
  { title: "7-day Chinese tutorial", desc: "Keep the original hands-on learning path while the English version is prepared page by page.", href: "/zh/7-days" },
  { title: "Migration notes", desc: "Chinese migration material for users moving from earlier local agent workflows.", href: "/zh/migrate" },
];
---
<Layout hasAlternate={true} title={title} description={description} schema={schema} lang="en" canonicalPath="/">
  <Nav lang="en" />
  <main class="pt-20">
    <section class="max-w-6xl mx-auto px-6 pt-16 pb-20 relative">
      <div class="absolute inset-0 -z-10 opacity-30 overflow-hidden rounded-3xl">
        <img src="/images/hero.png" alt="" class="w-full h-full object-cover" loading="eager" fetchpriority="high" width="1376" height="768" />
        <div class="absolute inset-0 bg-gradient-to-b from-[#0A0A0F]/50 via-[#0A0A0F]/80 to-[#0A0A0F]"></div>
      </div>

      <div class="flex flex-col items-center text-center mb-14">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-white/[0.1] bg-[#1b1b20] mb-8">
          <span class="w-2 h-2 rounded-full bg-[#18E299] animate-pulse"></span>
          <span class="text-xs font-bold tracking-widest text-white">ENGLISH DEFAULT · CHINESE GUIDE AVAILABLE</span>
        </div>

        <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold tracking-[-0.04em] mb-6">
          <span class="text-[#18E299]">Start with</span><br/>
          <span class="text-white">Hermes Agent</span>
        </h1>

        <p class="text-xl md:text-2xl text-white/90 font-medium max-w-3xl mb-10">
          An English-first landing page for learning Hermes Agent, with the original Chinese tutorial preserved under <a href="/zh/" class="text-[#51ffb4] underline decoration-[#51ffb4]/40 underline-offset-4">/zh/</a>.
        </p>

        <div class="w-full max-w-3xl mb-8 px-4 py-3 rounded-lg border border-[#FFB962]/20 bg-[#FFB962]/5 text-[#FFB962] text-sm text-center">
          <span class="font-bold">Disclaimer:</span> This is an independent community guide. The <a href="https://hermes-agent.nousresearch.com/docs" target="_blank" rel="noopener noreferrer" class="underline">official Hermes Agent docs</a> are the source of truth.
        </div>

        <div class="flex flex-col sm:flex-row gap-4 mb-12">
          <a href="https://hermes-agent.nousresearch.com/docs"
             target="_blank"
             rel="noopener noreferrer"
             data-track-event="official_docs_click"
             class="cta-primary px-10 py-4 text-lg inline-flex items-center gap-2">
            Read official docs
            <span class="material-symbols-outlined text-sm">open_in_new</span>
          </a>
          <a href="/zh/"
             data-track-event="language_switch_click"
             class="px-10 py-4 border-2 border-white/20 text-white rounded-full font-bold text-lg hover:bg-white/5 transition-all active:scale-95">
            中文指南
          </a>
          <a href="https://github.com/mengjian-github/hermes101" target="_blank" rel="noopener noreferrer"
             data-track-event="github_click"
             class="px-10 py-4 bg-[#1b1b20] border border-white/10 text-white rounded-full font-bold text-lg hover:border-[#18E299]/50 hover:text-[#18E299] transition-all active:scale-95 inline-flex items-center gap-2">
            GitHub
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 border-y border-white/[0.05] py-10 w-full max-w-4xl">
          <div class="flex flex-col items-center">
            <span class="text-3xl font-black text-white">Official-first</span>
            <span class="text-sm font-bold text-white/60 tracking-widest uppercase mt-1">Docs alignment</span>
          </div>
          <div class="flex flex-col items-center">
            <span class="text-3xl font-black text-white">/zh/</span>
            <span class="text-sm font-bold text-white/60 tracking-widest uppercase mt-1">Chinese route</span>
          </div>
          <div class="flex flex-col items-center">
            <span class="text-3xl font-black text-white">hreflang</span>
            <span class="text-sm font-bold text-white/60 tracking-widest uppercase mt-1">SEO ready</span>
          </div>
        </div>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <div class="text-center mb-14">
        <div class="inline-block px-4 py-1.5 rounded-full bg-[#1b1b20] border border-[#3b4a41]/10 text-[#18E299] text-[10px] font-black tracking-[0.2em] uppercase mb-6">
          Quick start
        </div>
        <h2 class="text-3xl md:text-5xl font-black tracking-[-0.04em] text-white mb-4">Use the official docs for commands</h2>
        <p class="mt-8 text-[#bacbbe] max-w-2xl mx-auto text-lg">This site now avoids making the Chinese tutorial the default page. English content starts from official documentation and links into localized material only when useful.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {quickStart.map(item => (
          <a href={item.href} target="_blank" rel="noopener noreferrer" class="group bg-[#12121A] p-8 rounded-xl border border-[#3b4a41]/15 feature-card-glow transition-all duration-300 block">
            <span class="text-[#18E299] text-xs font-bold tracking-widest uppercase">{item.step}</span>
            <h3 class="text-xl font-bold text-white mt-4 mb-3 tracking-tight">{item.title}</h3>
            <p class="text-[#bacbbe] text-sm leading-relaxed">{item.desc}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="py-20 md:py-28 bg-[#131318]">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-14">
          <h2 class="text-3xl md:text-5xl font-black tracking-[-0.04em] text-white mb-4">Localized content plan</h2>
          <p class="text-lg text-[#bacbbe]">Chinese pages are now available as secondary localized routes.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {paths.map(item => (
            <a href={item.href} class="rounded-xl p-6 bg-[#1b1b20] border border-[#3b4a41]/15 transition-all duration-300 hover:-translate-y-1 hover:border-[#18E299]/30 group block">
              <h3 class="font-bold text-white text-lg mb-2">{item.title}</h3>
              <p class="text-sm text-[#bacbbe] leading-relaxed">{item.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer lang="en" />
</Layout>
