---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FeatureCard from '../components/FeatureCard.astro';

const title = "Hermes Agent 小白入门第一站 — hermes101";
const description = "5 分钟安装 Hermes Agent，7 天跟练入门，OpenClaw 一键无忧迁移。中文保姆级教程。";
const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "hermes101",
  "url": "https://hermes101.site",
  "description": description
};
---
<Layout title={title} description={description} schema={schema}>
  <Nav />
  <main>
    <section class="pt-24 pb-16 text-center bg-[linear-gradient(180deg,rgba(24,226,153,0.08)_0%,rgba(255,255,255,0)_60%)]">
      <div class="max-w-[960px] mx-auto px-6">
        <h1 class="text-[48px] font-semibold leading-[1.3] tracking-[-0.5px] mb-5">Hermes Agent 小白入门第一站</h1>
        <p class="text-lg text-[#666] mb-9">5 分钟安装 · 7 天跟练 · OpenClaw 一键迁移</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/setup" class="inline-block bg-[#0d0d0d] text-white px-8 py-3 rounded-full text-[15px] font-medium hover:opacity-92 transition-opacity">5 分钟安装 Hermes</a>
          <a href="/migrate" class="inline-block bg-white text-[#0d0d0d] px-8 py-3 rounded-full text-[15px] font-medium border border-black/[0.08] hover:bg-[#fafafa] transition-colors">从 OpenClaw 迁移</a>
        </div>
      </div>
    </section>

    <section class="py-16">
      <div class="max-w-[960px] mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <FeatureCard icon="⚡" title="5 分钟安装" desc="支持 Mac、Linux、Windows WSL2 和 Termux/Android。每步都有可复制命令和截图说明，预设小白可能遇到的每个坑。" />
          <FeatureCard icon="📅" title="7 天入门路径" desc="从第一次对话到接入飞书/Telegram 机器人，每天一个可验证成果。v0.9 新增 Dashboard、Fast Mode 和 backup/import。" />
          <FeatureCard icon="🔄" title="OpenClaw 无忧迁移" desc="使用 hermes claw migrate 一键迁移，配置不会丢。v0.9 新增 backup/import 与 /debug 诊断，迁移更安心。" />
        </div>
      </div>
    </section>

    <section class="pb-20 text-center">
      <div class="max-w-[960px] mx-auto px-6">
        <p class="text-[13px] text-[#666] mb-1.5">📌 本指南基于 Hermes v0.9.x | 最后更新：2026-04-15</p>
        <p class="text-[13px] text-[#666]">⚠️ 本站为社区独立入门指南，非 Nous Research 官方文档</p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
