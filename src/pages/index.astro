---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import AnimatedTerminal from '../components/AnimatedTerminal.astro';
import FeatureGrid from '../components/FeatureGrid.astro';

const title = "Hermes Agent 小白入门第一站 — hermes101";
const description = "5 分钟安装 Hermes Agent，7 天跟练入门，OpenClaw 一键无忧迁移。中文保姆级教程。";
const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "hermes101",
  "url": "https://hermes101.site",
  "description": description
};

const features = [
  { icon: "🧠", title: "智能记忆", desc: "跨 session 记忆，越用越懂你。上下文持续积累，对话更高效。" },
  { icon: "🔌", title: "22+ 平台", desc: "Telegram / Discord / 飞书 / Slack / WhatsApp / GitHub / 企业微信……" },
  { icon: "🤖", title: "多 Agent 协作", desc: "Profile 隔离，独立 bot token，多 agent 各司其职。" },
  { icon: "⏰", title: "定时自动化", desc: "自然语言创建 cron，自动投递到任意平台，解放双手。" },
  { icon: "🛠", title: "MCP 生态", desc: "200+ 技能包，一键安装。搜索、代码、文件、网络……应有尽有。" },
  { icon: "🔒", title: "安全沙箱", desc: "危险命令审批流程，容器隔离执行，安心使用无风险。" },
  { icon: "🎯", title: "多模型", desc: "OpenAI / Claude / GLM / Kimi / MiniMax / Ollama……灵活切换。" },
  { icon: "⚡", title: "并行执行", desc: "多 subagent 并发执行，后台进程实时监控，效率倍增。" },
  { icon: "🌍", title: "随处部署", desc: "Linux / Mac / WSL2 / Termux / Cloud / Server，到处能跑。" },
];

const days = [
  { day: 1, title: "安装与配置", desc: "一键安装 + API Key 配置" },
  { day: 2, title: "第一次对话", desc: "模型选择 + 基础交互" },
  { day: 3, title: "接入平台", desc: "Telegram / Discord 接入" },
  { day: 4, title: "MCP 技能", desc: "安装第一个技能包" },
  { day: 5, title: "自动化", desc: "定时任务 + 工作流" },
  { day: 6, title: "多 Agent", desc: "Profile 隔离 + 多 bot" },
  { day: 7, title: "上线运维", desc: "持久化 + 监控 + 备份" },
];

const platforms = [
  "Telegram", "Discord", "Slack", "飞书", "WhatsApp", "GitHub",
  "企业微信", "钉钉", "Line", "Matrix", "Teams", "微信公众号",
  "Twitter/X", "Reddit", "Email", "Web", "TUI", "CLI",
  "WeChat", "Kook", "Rocket.Chat", "Mattermost",
];
---
<Layout title={title} description={description} schema={schema}>
  <Nav />
  <main>
    <!-- ====== Section 1: Hero ====== -->
    <section class="relative overflow-hidden pt-20 pb-24 md:pt-28 md:pb-32">
      <!-- Gradient background -->
      <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(24,226,153,0.1), transparent 70%);"></div>
      <div class="dark absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 80% 60% at 50% -10%, rgba(24,226,153,0.08), transparent 70%);"></div>

      <div class="relative max-w-[1200px] mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16 items-center">
          <!-- Left (60%) -->
          <div class="lg:col-span-3">
            <!-- Badge -->
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-[13px] font-medium mb-6"
                 style="background: var(--bg-tertiary); border: 1px solid var(--border); color: var(--text-secondary);">
              <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#18E299]"></span>
              开源 AI Agent · 22+ 平台 · 200+ 技能
            </div>

            <!-- Title -->
            <h1 class="font-display text-[clamp(36px,5vw,56px)] font-semibold leading-[1.15] tracking-[-0.5px] mb-5" style="color: var(--text-primary);">
              你的 AI 编程助手，<br/><span class="brand-gradient-text">从安装到上线</span>
            </h1>

            <!-- Subtitle -->
            <p class="text-lg leading-relaxed mb-8 max-w-lg" style="color: var(--text-secondary);">
              5 分钟安装，7 天掌握。Hermes Agent 中文入门指南。
            </p>

            <!-- CTAs -->
            <div class="flex flex-wrap gap-4 mb-10">
              <a href="/setup"
                 class="inline-flex items-center gap-2 px-7 py-3.5 rounded-[var(--radius-button)] text-[15px] font-semibold text-white transition-transform hover:scale-[1.02] active:scale-[0.98]"
                 style="background: var(--brand-gradient); box-shadow: var(--glow-md);">
                开始安装
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </a>
              <a href="/7-days"
                 class="inline-flex items-center gap-2 px-7 py-3.5 rounded-[var(--radius-button)] text-[15px] font-semibold transition-colors"
                 style="background: var(--bg-tertiary); border: 1px solid var(--border); color: var(--text-primary);">
                查看文档 →
              </a>
            </div>

            <!-- Stats -->
            <div class="flex flex-wrap gap-x-6 gap-y-2 text-[14px]" style="color: var(--text-muted);">
              <span><strong class="font-semibold" style="color: var(--text-primary);">2,000+</strong> GitHub Stars</span>
              <span><strong class="font-semibold" style="color: var(--text-primary);">22+</strong> 接入平台</span>
              <span><strong class="font-semibold" style="color: var(--text-primary);">v0.9</strong> 稳定版</span>
            </div>
          </div>

          <!-- Right (40%): AnimatedTerminal -->
          <div class="lg:col-span-2">
            <AnimatedTerminal />
          </div>
        </div>
      </div>
    </section>

    <!-- ====== Section 2: Platform Bar ====== -->
    <section class="py-12" style="border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); background: var(--bg-secondary);">
      <div class="max-w-[1200px] mx-auto px-6">
        <p class="text-center text-sm font-medium mb-6" style="color: var(--text-muted);">支持 22+ 平台</p>
        <div class="flex flex-wrap justify-center gap-x-6 gap-y-3">
          {platforms.map(p => (
            <span class="text-sm font-medium transition-colors hover:text-[#18E299]" style="color: var(--text-secondary);">{p}</span>
          ))}
        </div>
      </div>
    </section>

    <!-- ====== Section 3: 9 Core Features ====== -->
    <section class="py-20 md:py-28">
      <div class="max-w-[1200px] mx-auto px-6">
        <div class="text-center mb-14">
          <h2 class="font-display text-[clamp(28px,3.5vw,40px)] font-semibold tracking-[-0.3px] mb-4" style="color: var(--text-primary);">9 大核心能力</h2>
          <p class="text-lg" style="color: var(--text-secondary);">不只是一个聊天机器人</p>
        </div>
        <FeatureGrid features={features} />
      </div>
    </section>

    <!-- ====== Section 4: 7-Day Path Preview ====== -->
    <section class="py-20 md:py-28" style="background: var(--bg-secondary);">
      <div class="max-w-[1200px] mx-auto px-6">
        <div class="text-center mb-14">
          <h2 class="font-display text-[clamp(28px,3.5vw,40px)] font-semibold tracking-[-0.3px] mb-4" style="color: var(--text-primary);">7 天从零到上线</h2>
          <p class="text-lg" style="color: var(--text-secondary);">每天都有可验证的成果</p>
        </div>

        <!-- Horizontal scrollable days -->
        <div class="flex gap-4 overflow-x-auto pb-4 snap-x snap-mandatory" style="-webkit-overflow-scrolling: touch;">
          {days.map(d => (
            <div class="flex-shrink-0 w-[200px] snap-start rounded-[var(--radius-card)] p-6 transition-all duration-300 hover:-translate-y-1"
                 style="background: var(--bg-primary); border: 1px solid var(--border);">
              <div class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold text-white mb-4"
                   style="background: var(--brand-gradient);">
                {d.day}
              </div>
              <h3 class="font-semibold mb-1.5" style="color: var(--text-primary);">Day {d.day}</h3>
              <p class="text-[15px] font-medium mb-1" style="color: var(--text-primary);">{d.title}</p>
              <p class="text-[13px]" style="color: var(--text-muted);">{d.desc}</p>
            </div>
          ))}
        </div>

        <div class="text-center mt-8">
          <a href="/7-days" class="inline-flex items-center gap-1.5 text-[15px] font-medium hover:text-[#18E299] transition-colors" style="color: var(--brand);">
            查看完整 7 天路径 →
          </a>
        </div>
      </div>
    </section>

    <!-- ====== Section 5: Migration Teaser ====== -->
    <section class="py-20 md:py-28">
      <div class="max-w-[1200px] mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <!-- Left text -->
          <div>
            <h2 class="font-display text-[clamp(28px,3.5vw,40px)] font-semibold tracking-[-0.3px] mb-4" style="color: var(--text-primary);">从 OpenClaw 迁移？<br/><span class="brand-gradient-text">3 步搞定</span></h2>
            <p class="text-lg leading-relaxed mb-6" style="color: var(--text-secondary);">
              使用 <code class="px-2 py-0.5 rounded-md text-sm" style="background: var(--bg-tertiary); font-family: var(--font-mono);">hermes claw migrate</code> 一键迁移，配置不会丢。备份、导入、诊断一条龙。
            </p>
            <a href="/migrate" class="inline-flex items-center gap-1.5 text-[15px] font-medium hover:text-[#18E299] transition-colors" style="color: var(--brand);">
              查看迁移指南 →
            </a>
          </div>

          <!-- Right code -->
          <div class="rounded-[var(--radius-code)] overflow-hidden" style="background: #0d0d14; border: 1px solid rgba(255,255,255,0.06);">
            <div class="px-5 py-4 overflow-x-auto">
              <pre class="text-sm leading-relaxed m-0" style="font-family: var(--font-mono); color: var(--code-text);"><code>{
`<span style="color: #18E299;">$</span> hermes claw migrate
<span style="color: #6a6a82;">Migrating OpenClaw config...</span>
<span style="color: #18E299;">✓</span> API keys migrated
<span style="color: #18E299;">✓</span> Platform configs migrated
<span style="color: #18E299;">✓</span> All 3 agents imported

<span style="color: #18E299;">$</span> hermes doctor
<span style="color: #18E299;">✓</span> All systems operational`
              }</code></pre>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ====== Section 6: CTA ====== -->
    <section class="py-20 md:py-28 relative overflow-hidden" style="background: var(--bg-secondary);">
      <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 60% 50% at 50% 50%, rgba(24,226,153,0.06), transparent 70%);"></div>
      <div class="relative max-w-[1200px] mx-auto px-6 text-center">
        <h2 class="font-display text-[clamp(28px,4vw,48px)] font-semibold tracking-[-0.3px] mb-4" style="color: var(--text-primary);">准备好开始了吗？</h2>
        <p class="text-lg mb-8" style="color: var(--text-secondary);">5 分钟完成安装，立刻体验 AI Agent 的力量</p>
        <a href="/setup"
           class="inline-flex items-center gap-2 px-10 py-4 rounded-[var(--radius-button)] text-lg font-semibold text-white transition-transform hover:scale-[1.02] active:scale-[0.98]"
           style="background: var(--brand-gradient); box-shadow: var(--glow-lg);">
          开始安装 Hermes Agent
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <p class="text-[13px] mt-4" style="color: var(--text-muted);">当前版本 v0.9.x · 开源免费 · MIT License</p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
