---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = "Hermes Agent Tutorial: Setup Guide for Beginners — hermes101";
const description = "Learn Hermes Agent from install to first working chat with official setup steps, provider selection, troubleshooting, and a 7-day beginner plan.";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://hermes101.dev/#website",
      "name": "Hermes Agent 101",
      "url": "https://hermes101.dev",
      "inLanguage": "en",
      "description": description,
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://hermes101.dev/resources/?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://hermes101.dev/#organization",
      "name": "hermes101.dev",
      "url": "https://hermes101.dev",
      "logo": "https://hermes101.dev/favicon.svg"
    },
    {
      "@type": "FAQPage",
      "@id": "https://hermes101.dev/#homepage-faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the fastest Hermes Agent tutorial path for beginners?",
          "acceptedAnswer": { "@type": "Answer", "text": "Install Hermes Agent, configure one provider, verify one CLI chat, then add gateway, tools, memory, skills, cron, and MCP one layer at a time." }
        },
        {
          "@type": "Question",
          "name": "Should I read hermes101.dev or the official Hermes Agent docs?",
          "acceptedAnswer": { "@type": "Answer", "text": "Use hermes101.dev as a beginner learning path and use the official Nous Research Hermes Agent docs as the source of truth for commands and feature details." }
        },
        {
          "@type": "Question",
          "name": "When should I set up Telegram, Discord, Slack, tools, skills, or cron?",
          "acceptedAnswer": { "@type": "Answer", "text": "Only after a plain Hermes CLI chat works. If the base provider setup is broken, gateway and automation setup makes debugging harder." }
        }
      ]
    }
  ]
};

const quickStart = [
  { step: "01", title: "Install", desc: "Run the official install script for your OS. macOS, Linux, WSL2, Termux, and native Windows are supported.", href: "/setup/" },
  { step: "02", title: "Configure", desc: "Choose a provider with hermes setup --portal or hermes model. This is the most important setup decision.", href: "/setup/" },
  { step: "03", title: "Verify", desc: "Start hermes, ask a normal question, and confirm it returns a useful answer before adding gateways or tools.", href: "/setup/" },
];

const paths = [
  { title: "I just want Hermes working", desc: "Run hermes setup --portal, then start hermes and verify one normal chat.", href: "/setup/" },
  { title: "I already know my provider", desc: "Run hermes model, save the provider and model, then test a plain chat.", href: "/setup/" },
  { title: "I want Telegram, Discord, Slack", desc: "First prove the CLI chat works. Then run hermes gateway setup.", href: "/setup/" },
  { title: "I want a local or self-hosted model", desc: "Configure a custom endpoint in hermes model, then verify endpoint URL, model name, and context length.", href: "/setup/" },
  { title: "I want fallback or routing", desc: "Keep fallback off until one base provider is stable. Add routing only after a clean chat works.", href: "/setup/" },
];

const comparisonRows = [
  { question: "Hermes Agent tutorial", answer: "Start with installation, provider selection, and one successful CLI chat before adding gateway, skills, cron, memory, or MCP." },
  { question: "Hermes Agent setup", answer: "Use hermes setup --portal for the fastest Nous Portal path, or hermes model when you already know the provider and model." },
  { question: "Hermes Agent quickstart", answer: "Install, reload the shell, run hermes, ask one short prompt, then use the recovery checklist if the answer is empty or broken." },
];

const faqRows = [
  { question: "What is the fastest Hermes Agent tutorial path?", answer: "Install Hermes Agent, configure one provider, verify one CLI chat, then add gateway, tools, memory, skills, cron, and MCP one layer at a time.", href: "/quickstart/" },
  { question: "Should I trust hermes101.dev or the official docs?", answer: "Use this site as a beginner path. Use the official Nous Research docs as the source of truth for commands, features, and release changes.", href: "https://hermes-agent.nousresearch.com/docs" },
  { question: "When should I add Telegram, Discord, Slack, skills, or cron?", answer: "After a plain CLI chat works. If the base provider setup is broken, automation and gateway setup create confusing failure modes.", href: "/7-days/" },
  { question: "What should I measure before scaling traffic?", answer: "Track quickstart starts, install-command copies, docs navigation, GitHub clicks, and product referrals before any paid spend or public distribution.", href: "/resources/" },
];
---
<Layout hasAlternate={true} title={title} description={description} schema={schema} lang="en" canonicalPath="/">
  <Nav lang="en" />
  <main class="pt-20">
    <section class="max-w-6xl mx-auto px-6 pt-16 pb-20 relative">
      <div class="absolute inset-0 -z-10 opacity-30 overflow-hidden rounded-3xl">
        <img src="/images/hero.webp" alt="Hermes Agent terminal setup dashboard preview" class="w-full h-full object-cover" loading="eager" fetchpriority="high" width="1376" height="768" />
        <div class="absolute inset-0 bg-gradient-to-b from-[#0A0A0F]/50 via-[#0A0A0F]/80 to-[#0A0A0F]"></div>
      </div>

      <div class="flex flex-col items-center text-center mb-14">
        <div class="inline-flex max-w-full flex-wrap items-center justify-center gap-2 px-4 py-1.5 rounded-full border border-white/[0.1] bg-[#1b1b20] mb-8">
          <span class="w-2 h-2 rounded-full bg-[#18E299] animate-pulse"></span>
          <span class="min-w-0 break-words text-[11px] md:text-xs font-bold tracking-[0.14em] md:tracking-widest text-white">OFFICIAL-CHECKED BEGINNER GUIDE · LAST CHECKED: 2026-07-09</span>
        </div>

        <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold tracking-[-0.04em] mb-6">
          <span class="text-[#18E299]">Hermes Agent</span><br/>
          <span class="text-white">Setup Tutorial</span>
        </h1>

        <p class="text-xl md:text-2xl text-white/90 font-medium max-w-3xl mb-10">
          Install Hermes Agent, choose your provider, verify your first chat, and know the next step before you touch gateways, skills, tools, or automation.
        </p>

        <div class="w-full max-w-3xl mb-8 px-4 py-3 rounded-lg border border-[#FFB962]/20 bg-[#FFB962]/5 text-[#FFB962] text-sm text-center">
          <span class="font-bold">Disclaimer:</span> This is an independent beginner guide. Hermes Agent is developed by Nous Research. The <a href="https://hermes-agent.nousresearch.com/docs" target="_blank" rel="noopener noreferrer" class="underline">official docs</a> are the source of truth.
        </div>

        <div class="flex flex-col sm:flex-row gap-4 mb-12">
          <a href="/quickstart/"
             data-track-event="start_quickstart_click"
             class="cta-primary px-10 py-4 text-lg inline-flex items-center gap-2">
            Start the Quickstart
          </a>
          <a href="/setup/"
             data-track-event="start_install_click"
             class="px-10 py-4 border-2 border-white/20 text-white rounded-full font-bold text-lg hover:bg-white/5 transition-all active:scale-95">
            Copy Install Command
          </a>
          <a href="https://hermes-agent.nousresearch.com/docs"
             target="_blank"
             rel="noopener noreferrer"
             data-track-event="official_docs_click"
             class="px-10 py-4 bg-[#1b1b20] border border-white/10 text-white rounded-full font-bold text-lg hover:border-[#18E299]/50 hover:text-[#18E299] transition-all active:scale-95 inline-flex items-center gap-2">
            View Official Docs
            <span class="material-symbols-outlined text-sm">open_in_new</span>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 border-y border-white/[0.05] py-10 w-full max-w-4xl">
          <div class="flex flex-col items-center">
            <span class="text-3xl font-black text-white">Install</span>
            <span class="text-sm font-bold text-white/60 tracking-widest uppercase mt-1">One command</span>
          </div>
          <div class="flex flex-col items-center">
            <span class="text-3xl font-black text-white">Configure</span>
            <span class="text-sm font-bold text-white/60 tracking-widest uppercase mt-1">Provider + model</span>
          </div>
          <div class="flex flex-col items-center">
            <span class="text-3xl font-black text-white">First chat</span>
            <span class="text-sm font-bold text-white/60 tracking-widest uppercase mt-1">Verify it works</span>
          </div>
        </div>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <div class="text-center mb-14">
        <div class="inline-block px-4 py-1.5 rounded-full bg-[#1b1b20] border border-[#3b4a41]/10 text-[#18E299] text-[10px] font-black tracking-[0.2em] uppercase mb-6">
          Quick start
        </div>
        <h2 class="text-3xl md:text-5xl font-black tracking-[-0.04em] text-white mb-4">From zero to working chat</h2>
        <p class="mt-8 text-[#bacbbe] max-w-2xl mx-auto text-lg">Follow the shortest path. Do not add gateways, cron, skills, or routing until a plain chat works.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {quickStart.map(item => (
          <a href={item.href} class="group bg-[#12121A] p-8 rounded-xl border border-[#3b4a41]/15 feature-card-glow transition-all duration-300 block">
            <span class="text-[#18E299] text-xs font-bold tracking-widest uppercase">{item.step}</span>
            <h3 class="text-xl font-bold text-white mt-4 mb-3 tracking-tight">{item.title}</h3>
            <p class="text-[#bacbbe] text-sm leading-relaxed">{item.desc}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="py-20 md:py-28 bg-[#131318]">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-14">
          <h2 class="text-3xl md:text-5xl font-black tracking-[-0.04em] text-white mb-4">Pick the fastest path for your setup</h2>
          <p class="text-lg text-[#bacbbe]">If Hermes cannot complete a normal chat, do not add gateway, cron, skills, voice, or routing yet. Fix the base chat first.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {paths.map(item => (
            <a href={item.href} class="rounded-xl p-6 bg-[#1b1b20] border border-[#3b4a41]/15 transition-all duration-300 hover:-translate-y-1 hover:border-[#18E299]/30 group block">
              <h3 class="font-bold text-white text-lg mb-2">{item.title}</h3>
              <p class="text-sm text-[#bacbbe] leading-relaxed">{item.desc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-8 items-start">
        <div>
          <div class="inline-block px-4 py-1.5 rounded-full bg-[#1b1b20] border border-[#3b4a41]/10 text-[#18E299] text-[10px] font-black tracking-[0.2em] uppercase mb-6">
            Search answer
          </div>
          <h2 class="text-3xl md:text-5xl font-black tracking-[-0.04em] text-white mb-5">Hermes Agent tutorial: what to do first?</h2>
          <p class="text-[#bacbbe] text-lg leading-relaxed mb-8">The safe path is not “turn on every feature.” Install Hermes Agent, choose one provider, verify one normal chat, then add messaging, tools, memory, skills, cron, and MCP in that order. This keeps setup errors small and searchable.</p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="/quickstart/" class="cta-primary px-8 py-3 justify-center" data-track-event="start_quickstart_click">Follow the quickstart</a>
            <a href="/7-days/" class="px-8 py-3 rounded-full border border-white/10 text-white font-bold hover:border-[#18E299]/50 hover:text-[#18E299] transition-all text-center" data-track-event="doc_nav_click">See the 7-day path</a>
          </div>
        </div>
        <div class="rounded-2xl bg-[#1b1b20] border border-white/[0.06] overflow-hidden">
          {comparisonRows.map((row, index) => (
            <div class:list={["p-6", index !== comparisonRows.length - 1 && "border-b border-white/[0.06]"]}>
              <h3 class="text-white font-bold mb-2">{row.question}</h3>
              <p class="text-sm text-[#bacbbe] leading-relaxed">{row.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-6 py-20 md:py-28">
      <div class="text-center mb-14">
        <h2 class="text-3xl md:text-5xl font-black tracking-[-0.04em] text-white mb-4">What you will have after this guide</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="p-6 rounded-xl bg-[#1b1b20] border border-[#3b4a41]/15">
          <h3 class="font-bold text-white text-lg mb-2">Hermes installed</h3>
          <p class="text-sm text-[#bacbbe]">On macOS, Linux, WSL2, Windows, or Termux.</p>
        </div>
        <div class="p-6 rounded-xl bg-[#1b1b20] border border-[#3b4a41]/15">
          <h3 class="font-bold text-white text-lg mb-2">Provider selected</h3>
          <p class="text-sm text-[#bacbbe]">Through hermes setup --portal or hermes model.</p>
        </div>
        <div class="p-6 rounded-xl bg-[#1b1b20] border border-[#3b4a41]/15">
          <h3 class="font-bold text-white text-lg mb-2">One verified chat</h3>
          <p class="text-sm text-[#bacbbe]">A plain CLI conversation that returns useful answers.</p>
        </div>
        <div class="p-6 rounded-xl bg-[#1b1b20] border border-[#3b4a41]/15">
          <h3 class="font-bold text-white text-lg mb-2">Recovery checklist</h3>
          <p class="text-sm text-[#bacbbe]">For broken replies, model errors, gateway issues, and profile confusion.</p>
        </div>
        <div class="p-6 rounded-xl bg-[#1b1b20] border border-[#3b4a41]/15">
          <h3 class="font-bold text-white text-lg mb-2">7-day path</h3>
          <p class="text-sm text-[#bacbbe]">For tools, memory, skills, messaging, and automation.</p>
        </div>
        <div class="p-6 rounded-xl bg-[#1b1b20] border border-[#3b4a41]/15">
          <h3 class="font-bold text-white text-lg mb-2">Source links</h3>
          <p class="text-sm text-[#bacbbe]">Every page links back to official docs and shows last checked date.</p>
        </div>
      </div>
    </section>

    <section class="py-20 md:py-28 bg-[#131318]">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-10 items-start">
          <div>
            <div class="inline-block px-4 py-1.5 rounded-full bg-[#1b1b20] border border-[#3b4a41]/10 text-[#18E299] text-[10px] font-black tracking-[0.2em] uppercase mb-6">
              Beginner FAQ
            </div>
            <h2 class="text-3xl md:text-5xl font-black tracking-[-0.04em] text-white mb-5">Short answers for Hermes Agent setup searches</h2>
            <p class="text-[#bacbbe] text-lg leading-relaxed">These are the questions that decide whether a beginner starts the quickstart, bounces back to search, or clicks into official docs.</p>
          </div>
          <div class="grid grid-cols-1 gap-4">
            {faqRows.map(item => (
              <a href={item.href} class="block rounded-2xl bg-[#1b1b20] border border-white/[0.06] p-6 hover:border-[#18E299]/30 hover:-translate-y-0.5 transition-all" data-track-event="homepage_faq_click">
                <h3 class="text-white font-bold text-lg mb-2">{item.question}</h3>
                <p class="text-[#bacbbe] leading-relaxed text-sm">{item.answer}</p>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-6 py-24">
      <div class="rounded-3xl bg-gradient-to-br from-[#18E299]/12 via-[#1b1b20] to-[#0E0E13] border border-[#18E299]/15 p-8 md:p-10">
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-8 items-center">
          <div>
            <p class="text-xs font-black tracking-[0.2em] uppercase text-[#51ffb4] mb-3">After the tutorial</p>
            <h2 class="text-2xl md:text-4xl font-black text-white tracking-[-0.03em] mb-3">Building a real always-on agent workflow?</h2>
            <p class="text-[#bacbbe] leading-relaxed max-w-2xl">Use this guide to get Hermes stable first. If your next step is shipping a production site or AI workflow, track that referral separately so we can tell tutorial traffic from product-intent traffic.</p>
          </div>
          <div class="flex flex-col sm:flex-row lg:flex-col gap-3">
            <a href="https://shipsolo.io/" target="_blank" rel="noopener noreferrer" data-product-referral="true" class="cta-primary px-8 py-3 justify-center">Explore ShipSolo</a>
            <a href="https://github.com/mengjian-github/hermes101/issues" target="_blank" rel="noopener noreferrer" data-lead-intent="true" class="px-8 py-3 rounded-full border border-white/10 text-white font-bold hover:border-[#18E299]/50 hover:text-[#18E299] transition-all text-center">Request a guide</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer lang="en" />
</Layout>
