---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { readFileSync } from 'node:fs';

const title = "Day 2 — 配置模型与 API Key | 7 天教程 — hermes101";
const description = "配置模型 Provider 和 API Key，切换模型并验证回复质量。";
const schema = {"@context": "https://schema.org", "@type": "LearningResource", "name": title, "description": description};

const pageContent = readFileSync('/root/hermes101-site/src/content/7-days-day-2.html', 'utf-8');
---

<Layout title={title} description={description} schema={schema}>
  <Nav />
  <main class="pt-28 pb-24 min-h-screen">
    <Fragment set:html={pageContent} />
  </main>
  <Footer />
</Layout>
