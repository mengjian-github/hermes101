---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';

const title = "Day 1 — 安装 Hermes Agent | 7 天教程 — hermes101";
const description = "Day 1 teaches first Hermes Agent install, shell reload, first chat verification, platform notes for Mac, Linux, and WSL2, plus common beginner fixes.";
const schema = {"@context": "https://schema.org", "@type": "LearningResource", "name": title, "description": description};

const rawContent = readFileSync(path.resolve(process.cwd(), 'src/content', '7-days-day-1.html'), 'utf-8');
// For non-zh pages: strip /zh prefix from internal links, but keep external links intact
const pageContent = rawContent.replace(/href="\/zh\//g, 'href="/');
---

<Layout lang="zh-CN" canonicalPath="/7-days/day-1/" title={title} description={description} schema={schema}>
  <Nav lang="zh-CN" />
  <main class="pt-28 pb-24 min-h-screen">
    <Fragment set:html={pageContent} />
  </main>
  <Footer lang="zh-CN" />
</Layout>
