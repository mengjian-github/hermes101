---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';

const title = "Day 6 — 记忆、会话与备份 | 7 天教程 — hermes101";
const description = "Day 6 covers Hermes Agent memory, session context, compression behavior, backup habits, and recovery checks for long-running projects.";
const schema = {"@context": "https://schema.org", "@type": "LearningResource", "name": title, "description": description};

const rawContent = readFileSync(path.resolve(process.cwd(), 'src/content', '7-days-day-6.html'), 'utf-8');
const pageContent = rawContent.replace(/href="\/zh\//g, 'href="/');
---

<Layout lang="en" canonicalPath="/7-days/day-6/" title={title} description={description} schema={schema}>
  <Nav lang="en" />
  <main class="pt-28 pb-24 min-h-screen">
    <Fragment set:html={pageContent} />
  </main>
  <Footer lang="en" />
</Layout>
