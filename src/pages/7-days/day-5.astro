---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { readFileSync } from 'node:fs';

const title = "Day 5 — 安装并使用技能 | 7 天教程 — hermes101";
const description = "安装并使用 Hermes 技能——可复用的工作流和知识包。";
const schema = {"@context": "https://schema.org", "@type": "LearningResource", "name": title, "description": description};

const pageContent = readFileSync('/root/hermes101-site/src/content/7-days-day-5.html', 'utf-8');
---

<Layout title={title} description={description} schema={schema}>
  <Nav />
  <main class="pt-28 pb-24 min-h-screen">
    <Fragment set:html={pageContent} />
  </main>
  <Footer />
</Layout>
