---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';

const title = "Day 5 — 安装并使用技能 | 7 天教程 — hermes101";
const description = "安装并使用 Hermes 技能——可复用的工作流和知识包。";
const schema = {"@context": "https://schema.org", "@type": "LearningResource", "name": title, "description": description};

const rawContent = readFileSync(path.resolve(process.cwd(), 'src/content', '7-days-day-5.html'), 'utf-8');
const pageContent = rawContent.replace(/href="\/zh\//g, 'href="/');
---

<Layout lang="zh-CN" canonicalPath="/zh/7-days/day-5/" noindex={true} title={title} description={description} schema={schema}>
  <Nav lang="zh-CN" />
  <main class="pt-28 pb-24 min-h-screen">
    <Fragment set:html={pageContent} />
  </main>
  <Footer lang="zh-CN" />
</Layout>
