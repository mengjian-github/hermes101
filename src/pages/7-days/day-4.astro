---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';

const title = "Day 4 — 调用内置工具 | 7 天教程 — hermes101";
const description = "Day 4 walks through Hermes Agent tools for web search, terminal commands, browser actions, file reading, and safe verification so beginners can finish real tasks.";
const schema = {"@context": "https://schema.org", "@type": "LearningResource", "name": title, "description": description};

const rawContent = readFileSync(path.resolve(process.cwd(), 'src/content', '7-days-day-4.html'), 'utf-8');
const pageContent = rawContent.replace(/href="\/zh\//g, 'href="/');
---

<Layout lang="zh-CN" canonicalPath="/7-days/day-4/" title={title} description={description} schema={schema}>
  <Nav lang="zh-CN" />
  <main class="pt-28 pb-24 min-h-screen">
    <Fragment set:html={pageContent} />
  </main>
  <Footer lang="zh-CN" />
</Layout>
