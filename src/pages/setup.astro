---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = "安装 Hermes Agent — hermes101";
const description = "5 分钟完成 Hermes Agent 安装。支持 Mac / Linux / Windows WSL2 / Termux，一键脚本安装。";
---
<Layout title={title} description={description}>
  <Nav />
  <main class="pt-28 pb-24 px-6 max-w-5xl mx-auto min-h-screen flex flex-col">
    <!-- Hero -->
    <div class="mb-16 text-center md:text-left fade-in-up">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1b20] ghost-border mb-6">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#51ffb4] opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-[#51ffb4]"></span>
        </span>
        <span class="text-[10px] font-bold uppercase tracking-widest text-[#51ffb4]">5分钟完成安装</span>
      </div>
      <h1 class="text-4xl md:text-6xl font-extrabold text-white tracking-[-0.04em] mb-6">
        安装 <span class="text-[#51ffb4]">Hermes Agent</span>
      </h1>
      <p class="text-[#bacbbe] text-lg max-w-2xl leading-relaxed">
        欢迎使用 Hermes 智能代理。请按照以下步骤配置您的本地开发环境，开启下一代 AI 自动化工作流。
      </p>
    </div>

    <!-- Pre-check -->
    <div class="mb-16 fade-in-up">
      <h3 class="text-sm font-bold tracking-[0.2em] uppercase text-[#18E299] mb-6 flex items-center gap-3">
        <span class="w-12 h-px bg-[var(--brand)]/30"></span>
        前置条件
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-[#1b1b20] ghost-border group hover:bg-[#1f1f25] transition-colors duration-300">
          <div class="mb-4">
            <span class="material-symbols-outlined text-[#51ffb4]" style="font-variation-settings: 'FILL' 1;">developer_board</span>
          </div>
          <h3 class="text-white font-bold mb-2">Node.js 环境</h3>
          <p class="text-sm text-[#bacbbe]">推荐使用 Node.js 18.x 或更高版本以获得最佳兼容性。</p>
        </div>
        <div class="p-6 rounded-2xl bg-[#1b1b20] ghost-border group hover:bg-[#1f1f25] transition-colors duration-300">
          <div class="mb-4">
            <span class="material-symbols-outlined text-[#51ffb4]" style="font-variation-settings: 'FILL' 1;">account_tree</span>
          </div>
          <h3 class="text-white font-bold mb-2">Git 工具</h3>
          <p class="text-sm text-[#bacbbe]">用于同步最新核心组件及克隆必要的主题模板库。</p>
        </div>
        <div class="p-6 rounded-2xl bg-[#1b1b20] ghost-border group hover:bg-[#1f1f25] transition-colors duration-300">
          <div class="mb-4">
            <span class="material-symbols-outlined text-[#51ffb4]" style="font-variation-settings: 'FILL' 1;">cloud_done</span>
          </div>
          <h3 class="text-white font-bold mb-2">网络连接</h3>
          <p class="text-sm text-[#bacbbe]">安装过程中需要访问 Hermes 全球加速节点。</p>
        </div>
      </div>
    </div>

    <!-- OS Tab -->
    <div class="mb-12 border-b border-[#3b4a41]/15 flex items-center gap-8 overflow-x-auto no-scrollbar fade-in-up">
      <button class="pb-4 text-[#51ffb4] font-bold border-b-2 border-[#51ffb4] transition-all whitespace-nowrap" data-tab="mac" onclick="switchTab('mac')">Mac</button>
      <button class="pb-4 text-[#bacbbe] font-medium hover:text-white transition-all whitespace-nowrap" data-tab="linux" onclick="switchTab('linux')">Linux</button>
      <button class="pb-4 text-[#bacbbe] font-medium hover:text-white transition-all whitespace-nowrap" data-tab="wsl" onclick="switchTab('wsl')">Windows WSL2</button>
      <button class="pb-4 text-[#bacbbe] font-medium hover:text-white transition-all whitespace-nowrap" data-tab="termux" onclick="switchTab('termux')">Termux</button>
    </div>

    <!-- Timeline Steps -->
    <div class="space-y-16 relative fade-in-up">
      <!-- Connector Line -->
      <div class="absolute left-6 top-8 bottom-0 w-[2px] bg-gradient-to-b from-[#51ffb4]/30 via-[#3b4a41]/10 to-transparent"></div>

      <!-- Step 1 -->
      <div class="relative flex gap-8 md:gap-10">
        <div class="z-10 flex items-center justify-center w-12 h-12 rounded-full bg-[#35343a] border border-[#51ffb4]/50 shrink-0">
          <span class="text-[#51ffb4] font-bold">1</span>
        </div>
        <div class="flex-grow pt-1">
          <h4 class="text-2xl font-bold text-white mb-4">执行一键安装脚本</h4>
          <p class="text-[#bacbbe] mb-6 leading-relaxed">
            打开您的终端，执行下方的 curl 命令。该脚本会自动检测您的系统环境并安装最新的 Hermes 运行时及其依赖包。
          </p>
          <div class="rounded-xl bg-[#0E0E13] p-6 ghost-border font-mono text-sm group relative overflow-hidden">
            <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity">
              <button class="p-2 rounded-lg bg-[#2a292f] hover:bg-[#39383e] transition-colors text-[#51ffb4] copy-btn" data-copy="curl -fsSL https://get.hermes.agent/install.sh | sh">
                <span class="material-symbols-outlined text-sm">content_copy</span>
              </button>
            </div>
            <div class="flex gap-1.5 mb-3 border-b border-[#3b4a41]/10 pb-3">
              <div class="w-3 h-3 rounded-full bg-red-500/30"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500/30"></div>
              <div class="w-3 h-3 rounded-full bg-green-500/30"></div>
            </div>
            <code class="text-[#e4e1e9] break-all">
              <span class="text-[#18E299]">curl</span> -fsSL https://get.hermes.agent/install.sh | <span class="text-[#18E299]">sh</span>
            </code>
          </div>
          <!-- Success output -->
          <div class="mt-4 rounded-xl bg-[#0E0E13] p-4 ghost-border font-mono text-sm">
            <p class="text-[#51ffb4]">✓ Checking environment... OK</p>
            <p class="text-[#51ffb4]">✓ Installing Hermes runtime v0.9.1... Done</p>
            <p class="text-[#51ffb4]">✓ Linking binary to /usr/local/bin/hermes</p>
          </div>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="relative flex gap-8 md:gap-10">
        <div class="z-10 flex items-center justify-center w-12 h-12 rounded-full bg-[#35343a] border border-[#51ffb4]/50 shrink-0">
          <span class="text-[#51ffb4] font-bold">2</span>
        </div>
        <div class="flex-grow pt-1">
          <h4 class="text-2xl font-bold text-white mb-4">身份验证与配置</h4>
          <p class="text-[#bacbbe] mb-6 leading-relaxed">
            安装完成后，通过 CLI 执行初始化指令并输入您的 API 密钥，将本地代理与您的账户进行关联。
          </p>
          <div class="rounded-xl bg-[#0E0E13] p-6 ghost-border font-mono text-sm group relative overflow-hidden">
            <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity">
              <button class="p-2 rounded-lg bg-[#2a292f] hover:bg-[#39383e] transition-colors text-[#51ffb4] copy-btn" data-copy="hermes auth login --key YOUR_API_KEY">
                <span class="material-symbols-outlined text-sm">content_copy</span>
              </button>
            </div>
            <div class="flex gap-1.5 mb-3 border-b border-[#3b4a41]/10 pb-3">
              <div class="w-3 h-3 rounded-full bg-red-500/30"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500/30"></div>
              <div class="w-3 h-3 rounded-full bg-green-500/30"></div>
            </div>
            <code class="text-[#e4e1e9]">
              <span class="text-[#18E299]">hermes</span> auth login <span class="text-[#ffb962]">--key</span> YOUR_API_KEY
            </code>
          </div>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="relative flex gap-8 md:gap-10">
        <div class="z-10 flex items-center justify-center w-12 h-12 rounded-full bg-[#35343a] border border-[#51ffb4]/50 shrink-0">
          <span class="text-[#51ffb4] font-bold">3</span>
        </div>
        <div class="flex-grow pt-1">
          <h4 class="text-2xl font-bold text-white mb-4">启动 Hermes 引擎</h4>
          <p class="text-[#bacbbe] mb-6 leading-relaxed">
            一切就绪！启动后台守护进程，Hermes 将开始分析您的工作流并提供智能协助。
          </p>
          <div class="rounded-xl bg-[#0E0E13] p-6 ghost-border font-mono text-sm group relative overflow-hidden mb-8">
            <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 transition-opacity">
              <button class="p-2 rounded-lg bg-[#2a292f] hover:bg-[#39383e] transition-colors text-[#51ffb4] copy-btn" data-copy="hermes start">
                <span class="material-symbols-outlined text-sm">content_copy</span>
              </button>
            </div>
            <div class="flex gap-1.5 mb-3 border-b border-[#3b4a41]/10 pb-3">
              <div class="w-3 h-3 rounded-full bg-red-500/30"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500/30"></div>
              <div class="w-3 h-3 rounded-full bg-green-500/30"></div>
            </div>
            <code class="text-[#e4e1e9]">
              <span class="text-[#18E299]">hermes</span> start
            </code>
          </div>

          <!-- Done CTA -->
          <div class="p-8 rounded-3xl bg-gradient-to-br from-[#18E299]/10 to-transparent border border-[var(--brand)]/10">
            <div class="flex flex-col md:flex-row items-center justify-between gap-6">
              <div>
                <h5 class="text-xl font-bold text-white mb-2">准备好了吗？</h5>
                <p class="text-[#bacbbe] text-sm">开始 7 天入门路径，从零到上线。</p>
              </div>
              <a href="/7-days"
                 class="cta-primary w-full md:w-auto px-10 py-4 text-center uppercase tracking-wider text-sm">
                开始 7 天教程
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- FAQ -->
    <div class="mt-24 fade-in-up">
      <h3 class="text-sm font-bold tracking-[0.2em] uppercase text-[#18E299] mb-8 flex items-center gap-3">
        <span class="w-12 h-px bg-[var(--brand)]/30"></span>
        常见问题
      </h3>
      <div class="space-y-4">
        <details class="group p-6 rounded-2xl bg-[#1b1b20] ghost-border cursor-pointer">
          <summary class="flex items-center justify-between list-none">
            <span class="font-semibold text-white">安装脚本报错 "Permission Denied" 怎么办？</span>
            <span class="material-symbols-outlined text-[#51ffb4] group-open:rotate-180 transition-transform">expand_more</span>
          </summary>
          <div class="mt-4 text-[#bacbbe] text-sm leading-relaxed">
            通常是因为缺少 sudo 权限。在命令前加上 <code class="text-[#18E299] font-mono px-1.5 py-0.5 bg-[var(--brand)]/5 rounded">sudo</code>，或确保有当前目录的写入权限。Mac 用户请确认已安装 Xcode Command Line Tools。
          </div>
        </details>
        <details class="group p-6 rounded-2xl bg-[#1b1b20] ghost-border cursor-pointer">
          <summary class="flex items-center justify-between list-none">
            <span class="font-semibold text-white">如何卸载 Hermes Agent？</span>
            <span class="material-symbols-outlined text-[#859589] group-open:rotate-180 transition-transform">expand_more</span>
          </summary>
          <div class="mt-4 text-[#bacbbe] text-sm leading-relaxed">
            执行 <code class="text-[#18E299] font-mono px-1.5 py-0.5 bg-[var(--brand)]/5 rounded">hermes uninstall</code> 即可完整清理。配置文件保留在 ~/.hermes/，可手动删除。
          </div>
        </details>
        <details class="group p-6 rounded-2xl bg-[#1b1b20] ghost-border cursor-pointer">
          <summary class="flex items-center justify-between list-none">
            <span class="font-semibold text-white">支持哪些操作系统架构？</span>
            <span class="material-symbols-outlined text-[#859589] group-open:rotate-180 transition-transform">expand_more</span>
          </summary>
          <div class="mt-4 text-[#bacbbe] text-sm leading-relaxed">
            支持 x64 和 ARM64 架构。Mac（Intel/M1+）、Linux、Windows WSL2、Android Termux 均可运行。
          </div>
        </details>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script is:inline>
  // Copy button
  document.querySelectorAll('.copy-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var text = this.getAttribute('data-copy');
      navigator.clipboard.writeText(text).then(function() {
        var icon = btn.querySelector('.material-symbols-outlined');
        icon.textContent = 'check';
        setTimeout(function() { icon.textContent = 'content_copy'; }, 1500);
      });
    });
  });
  // OS tab (visual only for static site)
  function switchTab(tab) {
    document.querySelectorAll('[data-tab]').forEach(function(btn) {
      if (btn.getAttribute('data-tab') === tab) {
        btn.className = 'pb-4 text-[#51ffb4] font-bold border-b-2 border-[#51ffb4] transition-all whitespace-nowrap';
      } else {
        btn.className = 'pb-4 text-[#bacbbe] font-medium hover:text-white transition-all whitespace-nowrap';
      }
    });
  }
</script>
