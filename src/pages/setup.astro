---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';

const title = "Hermes Agent Setup Guide — hermes101";
const description = "Install Hermes Agent, reload your shell, choose a provider with hermes model or hermes setup --portal, and verify that Hermes can complete a normal chat.";
const schema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "Hermes Agent Setup Guide",
  "description": description,
  "step": [
    { "@type": "HowToStep", "name": "Install Hermes Agent", "text": "Run curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash" },
    { "@type": "HowToStep", "name": "Reload shell", "text": "source ~/.bashrc or source ~/.zshrc" },
    { "@type": "HowToStep", "name": "Choose provider", "text": "Run hermes setup --portal or hermes model" },
    { "@type": "HowToStep", "name": "Verify first chat", "text": "Run hermes and ask a normal question" }
  ]
};

const pageContent = readFileSync(path.resolve(process.cwd(), 'src/content', 'setup-content-en.html'), 'utf-8');
---

<Layout lang="en" canonicalPath="/setup/" title={title} description={description} schema={schema}>
  <Nav lang="en" />
  <main class="pt-28 pb-24 min-h-screen">
    <Fragment set:html={pageContent} />
  </main>
  <Footer lang="en" />
</Layout>
