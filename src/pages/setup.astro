---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import VersionBanner from '../components/VersionBanner.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Accordion from '../components/Accordion.astro';
import CheckItem from '../components/CheckItem.astro';

const title = "Hermes Agent 安装教程（Mac/Linux/Windows/Termux）— hermes101";
const description = "保姆级 5 分钟安装指南。支持 Mac、Linux、Windows WSL2、Termux/Android。每步带可复制命令和常见报错修复。";
const schema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": title,
  "description": description,
  "author": { "@type": "Organization", "name": "hermes101" },
  "datePublished": "2026-04-15",
  "dateModified": "2026-04-15",
  "keywords": "Hermes Agent 安装, Hermes Agent Windows 安装, Hermes Agent WSL2, Hermes Agent Termux, Hermes v0.9"
};
---
<Layout title={title} description={description} schema={schema}>
  <Nav />
  <main class="pb-20">
    <article class="max-w-[800px] mx-auto px-6">
      <VersionBanner />

      <h1 class="text-[36px] font-semibold leading-[1.3] tracking-[-0.3px] mt-10 mb-2">5 分钟安装 Hermes Agent</h1>
      <p class="text-base text-[#666] mb-8">选择你的操作系统，每步都有可复制命令。即使你是第一次打开终端，也能顺利跑通。</p>

      <h2 class="text-xl font-semibold mt-10 mb-4">前置检查清单</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-8">
        <CheckItem id="setup-check-1" text="有一台能联网的电脑或手机" />
        <CheckItem id="setup-check-2" text="已注册 LLM API（OpenAI / Anthropic）" />
        <CheckItem id="setup-check-3" text="有 5 分钟跟着操作" />
      </div>

      <div class="tabs flex flex-col md:flex-row md:gap-6 border-b border-black/[0.06] mb-7">
        <button class="tab active text-left md:text-center py-3 md:pb-3 text-[15px] font-medium text-[#666] border-b-2 border-transparent md:-mb-[1px]" data-tab="mac">Mac</button>
        <button class="tab text-left md:text-center py-3 md:pb-3 text-[15px] font-medium text-[#666] border-b-2 border-transparent md:-mb-[1px]" data-tab="linux">Linux</button>
        <button class="tab text-left md:text-center py-3 md:pb-3 text-[15px] font-medium text-[#666] border-b-2 border-transparent md:-mb-[1px]" data-tab="windows">Windows WSL2</button>
        <button class="tab text-left md:text-center py-3 md:pb-3 text-[15px] font-medium text-[#666] border-b-2 border-transparent md:-mb-[1px]" data-tab="termux">Termux / Android</button>
      </div>

      <div class="tab-content" data-content="mac">
        <section class="mb-8">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-7 h-7 rounded-full bg-[#0d0d0d] text-white flex items-center justify-center text-[13px] font-semibold">1</span>
            <h3 class="text-[17px] font-semibold">安装 Python 环境</h3>
          </div>
          <p class="text-[15px] text-[#333] mb-3">Hermes 需要 Python 3.10 或更高版本。首先确认你的系统已经安装。</p>
          <CodeBlock code="python3 --version" />
        </section>
        <section class="mb-8">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-7 h-7 rounded-full bg-[#0d0d0d] text-white flex items-center justify-center text-[13px] font-semibold">2</span>
            <h3 class="text-[17px] font-semibold">安装 Hermes Agent</h3>
          </div>
          <p class="text-[15px] text-[#333] mb-3">使用 pip 一键安装。如果提示权限不足，可以加上 <code class="bg-[#fafafa] px-1.5 py-0.5 rounded text-sm">--user</code> 参数。</p>
          <CodeBlock code="pip3 install --user hermes-agent" />
        </section>
        <section class="mb-8">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-7 h-7 rounded-full bg-[#0d0d0d] text-white flex items-center justify-center text-[13px] font-semibold">3</span>
            <h3 class="text-[17px] font-semibold">运行安装验证</h3>
          </div>
          <p class="text-[15px] text-[#333] mb-3">安装完成后，运行以下命令确认版本。</p>
          <CodeBlock code="hermes --version" />
        </section>
        <section class="mb-8">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-7 h-7 rounded-full bg-[#0d0d0d] text-white flex items-center justify-center text-[13px] font-semibold">4</span>
            <h3 class="text-[17px] font-semibold">初始化配置向导</h3>
          </div>
          <p class="text-[15px] text-[#333] mb-3">v0.9 新增的交互式配置向导，会自动生成 <code class="bg-[#fafafa] px-1.5 py-0.5 rounded text-sm">~/.hermes/config.yaml</code>。</p>
          <CodeBlock code="hermes setup" />
        </section>

        <h2 class="text-xl font-semibold mt-10 mb-4">常见安装错误速查</h2>
        <Accordion title="Python 版本过低">
          <p>访问 <a href="https://python.org" class="text-[#0fa76e] underline">python.org</a> 下载 Python 3.11，或使用 Homebrew 安装：<code class="bg-[#fff] px-1.5 py-0.5 rounded text-sm">brew install python@3.11</code>。</p>
        </Accordion>
        <Accordion title="pip 安装权限失败">
          <p>尝试 <code class="bg-[#fff] px-1.5 py-0.5 rounded text-sm">pip3 install --user hermes-agent</code>，或使用虚拟环境 venv 进行安装。</p>
        </Accordion>
        <Accordion title="hermes 命令找不到">
          <p>运行 <code class="bg-[#fff] px-1.5 py-0.5 rounded text-sm">export PATH="$HOME/.local/bin:$PATH"</code>，并添加到 <code class="bg-[#fff] px-1.5 py-0.5 rounded text-sm">~/.zshrc</code> 或 <code class="bg-[#fff] px-1.5 py-0.5 rounded text-sm">~/.bashrc</code>。</p>
        </Accordion>
      </div>

      <div class="tab-content hidden" data-content="linux">
        <section class="mb-8">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-7 h-7 rounded-full bg-[#0d0d0d] text-white flex items-center justify-center text-[13px] font-semibold">1</span>
            <h3 class="text-[17px] font-semibold">安装 Python 环境</h3>
          </div>
          <p class="text-[15px] text-[#333] mb-3">大多数 Linux 发行版已带 Python3。检查版本，不足时请通过包管理器安装。</p>
          <CodeBlock code="python3 --version" />
        </section>
        <section class="mb-8">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-7 h-7 rounded-full bg-[#0d0d0d] text-white flex items-center justify-center text-[13px] font-semibold">2</span>
            <h3 class="text-[17px] font-semibold">安装 pip（如果没有）</h3>
          </div>
          <p class="text-[15px] text-[#333] mb-3">例如在 Ubuntu/Debian 上。</p>
          <CodeBlock code="sudo apt update && sudo apt install python3-pip -y" />
        </section>
        <section class="mb-8">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-7 h-7 rounded-full bg-[#0d0d0d] text-white flex items-center justify-center text-[13px] font-semibold">3</span>
            <h3 class="text-[17px] font-semibold">安装 Hermes Agent</h3>
          </div>
          <p class="text-[15px] text-[#333] mb-3">建议使用 <code class="bg-[#fafafa] px-1.5 py-0.5 rounded text-sm">--user</code> 避免权限问题。</p>
          <CodeBlock code="pip3 install --user hermes-agent" />
        </section>
        <section class="mb-8">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-7 h-7 rounded-full bg-[#0d0d0d] text-white flex items-center justify-center text-[13px] font-semibold">4</span>
            <h3 class="text-[17px] font-semibold">验证安装</h3>
          </div>
          <p class="text-[15px] text-[#333] mb-3">如果命令不在 PATH，请将 pip 的本地 bin 目录加入 PATH。</p>
          <CodeBlock code="hermes --version" />
        </section>
        <section class="mb-8">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-7 h-7 rounded-full bg-[#0d0d0d] text-white flex items-center justify-center text-[13px] font-semibold">5</span>
            <h3 class="text-[17px] font-semibold">初始化配置向导</h3>
          </div>
          <p class="text-[15px] text-[#333] mb-3">运行 v0.9 交互式向导生成配置文件。</p>
          <CodeBlock code="hermes setup" />
        </section>

        <h2 class="text-xl font-semibold mt-10 mb-4">常见安装错误速查</h2>
        <Accordion title="Python 版本过低">
          <p>Ubuntu/Debian 用户可运行 <code class="bg-[#fff] px-1.5 py-0.5 rounded text-sm">sudo apt install python3.11 python3.11-pip -y</code>，然后用 <code class="bg-[#fff] px-1.5 py-0.5 rounded text-sm">python3.11 -m pip install --user hermes-agent</code> 安装。</p>
        </Accordion>
        <Accordion title="pip 安装权限失败">
          <p>优先使用 <code class="bg-[#fff] px-1.5 py-0.5 rounded text-sm">pip3 install --user hermes-agent</code>；次选在 venv 虚拟环境中安装。</p>
        </Accordion>
        <Accordion title="hermes 命令找不到">
          <p>执行 <code class="bg-[#fff] px-1.5 py-0.5 rounded text-sm">export PATH="$HOME/.local/bin:$PATH"</code> 并写入 <code class="bg-[#fff] px-1.5 py-0.5 rounded text-sm">~/.bashrc</code>，然后 <code class="bg-[#fff] px-1.5 py-0.5 rounded text-sm">source ~/.bashrc</code>。</p>
        </Accordion>
      </div>

      <div class="tab-content hidden" data-content="windows">
        <section class="mb-8">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-7 h-7 rounded-full bg-[#0d0d0d] text-white flex items-center justify-center text-[13px] font-semibold">1</span>
            <h3 class="text-[17px] font-semibold">启用 WSL2</h3>
          </div>
          <p class="text-[15px] text-[#333] mb-3">以管理员身份打开 PowerShell，运行以下命令并重启电脑。</p>
          <CodeBlock code="wsl --install" />
        </section>
        <section class="mb-8">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-7 h-7 rounded-full bg-[#0d0d0d] text-white flex items-center justify-center text-[13px] font-semibold">2</span>
            <h3 class="text-[17px] font-semibold">进入 Ubuntu 终端</h3>
          </div>
          <p class="text-[15px] text-[#333] mb-3">在开始菜单搜索并打开 Ubuntu，设置用户名和密码。</p>
        </section>
        <section class="mb-8">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-7 h-7 rounded-full bg-[#0d0d0d] text-white flex items-center justify-center text-[13px] font-semibold">3</span>
            <h3 class="text-[17px] font-semibold">更新系统并安装 Python</h3>
          </div>
          <CodeBlock code="sudo apt update && sudo apt install python3 python3-pip -y" />
        </section>
        <section class="mb-8">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-7 h-7 rounded-full bg-[#0d0d0d] text-white flex items-center justify-center text-[13px] font-semibold">4</span>
            <h3 class="text-[17px] font-semibold">安装 Hermes Agent</h3>
          </div>
          <CodeBlock code="pip3 install --user hermes-agent" />
        </section>
        <section class="mb-8">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-7 h-7 rounded-full bg-[#0d0d0d] text-white flex items-center justify-center text-[13px] font-semibold">5</span>
            <h3 class="text-[17px] font-semibold">验证安装</h3>
          </div>
          <CodeBlock code="hermes --version" />
        </section>
        <section class="mb-8">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-7 h-7 rounded-full bg-[#0d0d0d] text-white flex items-center justify-center text-[13px] font-semibold">6</span>
            <h3 class="text-[17px] font-semibold">初始化配置向导</h3>
          </div>
          <CodeBlock code="hermes setup" />
        </section>

        <h2 class="text-xl font-semibold mt-10 mb-4">常见安装错误速查</h2>
        <Accordion title="WSL2 未启用">
          <p>在 PowerShell 中以管理员身份运行 <code class="bg-[#fff] px-1.5 py-0.5 rounded text-sm">wsl --install</code>，重启后继续安装。如仍失败，在 BIOS 开启虚拟化（Intel VT-x / AMD-V）。</p>
        </Accordion>
        <Accordion title="hermes 命令找不到">
          <p>在 WSL2 Ubuntu 中运行 <code class="bg-[#fff] px-1.5 py-0.5 rounded text-sm">export PATH="$HOME/.local/bin:$PATH"</code>，并写入 <code class="bg-[#fff] px-1.5 py-0.5 rounded text-sm">~/.bashrc</code>。</p>
        </Accordion>
        <Accordion title="WSL2 网络无法访问模型 API">
          <p>检查 Windows 防火墙是否阻止了 WSL2 网络访问；必要时在 WSL2 中配置代理（如 <code class="bg-[#fff] px-1.5 py-0.5 rounded text-sm">export https_proxy=http://host.docker.internal:7890</code>）。</p>
        </Accordion>
      </div>

      <div class="tab-content hidden" data-content="termux">
        <section class="mb-8">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-7 h-7 rounded-full bg-[#0d0d0d] text-white flex items-center justify-center text-[13px] font-semibold">1</span>
            <h3 class="text-[17px] font-semibold">安装 Termux</h3>
          </div>
          <p class="text-[15px] text-[#333] mb-3">从 F-Droid 或 GitHub 发行版下载安装 Termux（建议不要使用应用宝版本）。</p>
        </section>
        <section class="mb-8">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-7 h-7 rounded-full bg-[#0d0d0d] text-white flex items-center justify-center text-[13px] font-semibold">2</span>
            <h3 class="text-[17px] font-semibold">更新包列表并安装 Python</h3>
          </div>
          <CodeBlock code="pkg update && pkg install python python-pip -y" />
        </section>
        <section class="mb-8">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-7 h-7 rounded-full bg-[#0d0d0d] text-white flex items-center justify-center text-[13px] font-semibold">3</span>
            <h3 class="text-[17px] font-semibold">安装 Hermes Agent</h3>
          </div>
          <p class="text-[15px] text-[#333] mb-3">Termux 环境完全兼容，直接使用 pip 安装即可。</p>
          <CodeBlock code="pip install hermes-agent" />
        </section>
        <section class="mb-8">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-7 h-7 rounded-full bg-[#0d0d0d] text-white flex items-center justify-center text-[13px] font-semibold">4</span>
            <h3 class="text-[17px] font-semibold">验证安装</h3>
          </div>
          <CodeBlock code="hermes --version" />
        </section>
        <section class="mb-8">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-7 h-7 rounded-full bg-[#0d0d0d] text-white flex items-center justify-center text-[13px] font-semibold">5</span>
            <h3 class="text-[17px] font-semibold">初始化配置向导</h3>
          </div>
          <CodeBlock code="hermes setup" />
        </section>

        <h2 class="text-xl font-semibold mt-10 mb-4">常见安装错误速查</h2>
        <Accordion title="pip 安装失败或编译错误">
          <p>运行 <code class="bg-[#fff] px-1.5 py-0.5 rounded text-sm">pkg install clang libffi openssl -y</code> 后重试。</p>
        </Accordion>
        <Accordion title="Android 杀后台导致 Hermes 断连">
          <p>进入 Android 设置 → 电池 → 应用省电策略，将 Termux 设为无限制。如果运行了 gateway，建议使用 <code class="bg-[#fff] px-1.5 py-0.5 rounded text-sm">termux-wake-lock</code> 保持唤醒。</p>
        </Accordion>
        <Accordion title="hermes setup 卡住">
          <p>Termux 中某些键盘输入法可能与交互式向导不兼容，尝试换用 Hacker's Keyboard 或直接手动编辑 <code class="bg-[#fff] px-1.5 py-0.5 rounded text-sm">~/.hermes/config.yaml</code>。</p>
        </Accordion>
      </div>

      <div class="text-center pt-12 pb-4">
        <a href="/7-days#day-1" class="inline-block bg-[#0d0d0d] text-white px-8 py-3 rounded-full text-[15px] font-medium hover:opacity-92 transition-opacity">继续 Day 1 学习路径 →</a>
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .tab.active { color: #0d0d0d; border-bottom-color: #18E299; }
</style>
<script is:inline>
  (function() {
    const tabs = document.querySelectorAll('.tab');
    const contents = document.querySelectorAll('.tab-content');
    function activate(key) {
      tabs.forEach((t) => {
        if (t.dataset.tab === key) t.classList.add('active');
        else t.classList.remove('active');
      });
      contents.forEach((c) => {
        if (c.dataset.content === key) c.classList.remove('hidden');
        else c.classList.add('hidden');
      });
      localStorage.setItem('setup-tab', key);
    }
    tabs.forEach((t) => t.addEventListener('click', () => activate(t.dataset.tab)));
    const saved = localStorage.getItem('setup-tab');
    if (saved) activate(saved);
  })();
</script>
