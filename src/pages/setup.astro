---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';

const title = "Hermes Agent Setup Guide — hermes101";
const description = "Install Hermes Agent, reload your shell, choose a provider with hermes model or hermes setup --portal, and verify that Hermes can complete a normal chat.";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "HowTo",
      "name": "Hermes Agent Setup Guide",
      "description": description,
      "dateModified": "2026-07-09",
      "image": "https://hermes101.dev/images/setup.webp",
      "totalTime": "PT10M",
      "tool": [{ "@type": "HowToTool", "name": "Terminal" }],
      "step": [
        { "@type": "HowToStep", "position": 1, "name": "Install Hermes Agent", "url": "https://hermes101.dev/setup/#install-hermes-agent", "image": "https://hermes101.dev/images/setup.webp", "text": "Run curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash or iex (irm https://hermes-agent.nousresearch.com/install.ps1) on native Windows." },
        { "@type": "HowToStep", "position": 2, "name": "Reload shell", "url": "https://hermes101.dev/setup/#reload-shell", "text": "Run source ~/.bashrc or source ~/.zshrc, then confirm the hermes command is available." },
        { "@type": "HowToStep", "position": 3, "name": "Choose provider", "url": "https://hermes101.dev/setup/#choose-provider", "text": "Run hermes setup --portal for the guided Nous Portal path, or hermes model for manual provider selection." },
        { "@type": "HowToStep", "position": 4, "name": "Verify first chat", "url": "https://hermes101.dev/setup/#verify-first-chat", "text": "Run hermes and ask a normal question before enabling gateway, cron, skills, or routing." }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Which setup command should beginners use?", "acceptedAnswer": { "@type": "Answer", "text": "Use hermes setup for the general guided setup. Use hermes setup --portal when you want the fastest Nous Portal path." } },
        { "@type": "Question", "name": "What should I verify before adding Telegram or Discord?", "acceptedAnswer": { "@type": "Answer", "text": "Verify that the hermes command starts and returns a useful answer in a plain CLI chat." } },
        { "@type": "Question", "name": "What is the fastest Hermes Agent tutorial path?", "acceptedAnswer": { "@type": "Answer", "text": "Install Hermes Agent, run hermes model or hermes setup --portal, then run hermes and confirm a normal chat returns a useful answer. Only after that works should you add Telegram, Discord, Slack, tools, memory, skills, cron, or MCP." } }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Hermes Agent Tutorial", "item": "https://hermes101.dev/" },
        { "@type": "ListItem", "position": 2, "name": "Setup Guide", "item": "https://hermes101.dev/setup/" }
      ]
    }
  ]
};

const pageContent = readFileSync(path.resolve(process.cwd(), 'src/content', 'setup-content-en.html'), 'utf-8');
---

<Layout lang="en" canonicalPath="/setup/" title={title} description={description} schema={schema}>
  <Nav lang="en" />
  <main class="pt-28 pb-24 min-h-screen">
    <Fragment set:html={pageContent} />
  </main>
  <Footer lang="en" />
</Layout>
