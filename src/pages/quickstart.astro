---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';

const title = "Hermes Agent Quickstart: Setup Guide and First Chat — hermes101";
const description = "Install Hermes Agent, choose a provider, verify your first chat, fix setup errors, and know when to add gateway, tools, skills, or cron.";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": title,
      "description": description,
      "image": ["https://hermes101.dev/images/hero.webp"],
      "datePublished": "2026-07-01",
      "dateModified": "2026-07-08",
      "mainEntityOfPage": "https://hermes101.dev/quickstart/",
      "author": { "@type": "Organization", "name": "hermes101.dev", "url": "https://hermes101.dev" },
      "publisher": { "@type": "Organization", "name": "hermes101.dev", "url": "https://hermes101.dev", "logo": { "@type": "ImageObject", "url": "https://hermes101.dev/favicon.svg" } },
      "isPartOf": { "@type": "WebSite", "name": "hermes101.dev", "url": "https://hermes101.dev" },
      "citation": "https://hermes-agent.nousresearch.com/docs/getting-started/quickstart"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Hermes Agent Tutorial", "item": "https://hermes101.dev/" },
        { "@type": "ListItem", "position": 2, "name": "Quickstart", "item": "https://hermes101.dev/quickstart/" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Should I run hermes setup or hermes model first?",
          "acceptedAnswer": { "@type": "Answer", "text": "Run hermes setup for the guided setup. If you already know your provider and model, run hermes model and then verify one normal chat." }
        },
        {
          "@type": "Question",
          "name": "When should I configure gateway or messaging?",
          "acceptedAnswer": { "@type": "Answer", "text": "Only after a plain CLI chat works. If the provider or model is broken, gateway setup adds noise and makes debugging slower." }
        },
        {
          "@type": "Question",
          "name": "What is the quickest recovery path when Hermes does not respond?",
          "acceptedAnswer": { "@type": "Answer", "text": "Run hermes doctor, check the selected model with hermes model, then start hermes and test a short prompt before adding tools or automation." }
        }
      ]
    }
  ]
};

const pageContent = readFileSync(path.resolve(process.cwd(), 'src/content', 'quickstart-content-en.html'), 'utf-8');
---

<Layout lang="en" canonicalPath="/quickstart/" title={title} description={description} schema={schema}>
  <Nav lang="en" />
  <main class="pt-28 pb-24 min-h-screen">
    <Fragment set:html={pageContent} />
  </main>
  <Footer lang="en" />
</Layout>
