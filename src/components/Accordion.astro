---
export interface Props { title: string; id?: string; }
const { title, id } = Astro.props;
---
<div class="accordion rounded-[var(--radius-card)] overflow-hidden mb-3" {...(id ? { id } : {})} style="border: 1px solid var(--border);">
  <button class="accordion-header w-full px-5 py-4 flex justify-between items-center text-[15px] font-medium transition-colors cursor-pointer" style="background: var(--bg-primary); color: var(--text-primary);">
    <span>{title}</span>
    <span class="accordion-icon transition-transform duration-200" style="color: var(--text-muted);">&#9662;</span>
  </button>
  <div class="accordion-body hidden px-5 py-4 text-sm leading-relaxed" style="background: var(--bg-secondary); color: var(--text-secondary); border-top: 1px solid var(--border);">
    <slot />
  </div>
</div>
<script>
  document.querySelectorAll('.accordion-header').forEach((header) => {
    header.addEventListener('click', () => {
      const body = header.nextElementSibling;
      const icon = header.querySelector('.accordion-icon');
      if (!body) return;
      const isHidden = body.classList.contains('hidden');
      if (isHidden) {
        body.classList.remove('hidden');
        if (icon) icon.style.transform = 'rotate(180deg)';
      } else {
        body.classList.add('hidden');
        if (icon) icon.style.transform = 'rotate(0deg)';
      }
    });
  });
</script>
