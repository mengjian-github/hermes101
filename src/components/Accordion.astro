---
export interface Props { title: string; id?: string; }
const { title, id } = Astro.props;
---
<div class="accordion-item" {...(id ? { id } : {})}>
  <button class="accordion-header" style="font-size: 15px;">
    <span>{title}</span>
    <span class="accordion-icon transition-transform duration-200" style="color: var(--text-muted); font-size: 12px;">▼</span>
  </button>
  <div class="accordion-body hidden">
    <slot />
  </div>
</div>
<script>
  document.querySelectorAll('.accordion-header').forEach((header) => {
    header.addEventListener('click', () => {
      const item = header.closest('.accordion-item');
      const body = header.nextElementSibling;
      const icon = header.querySelector('.accordion-icon');
      if (!body) return;
      const isHidden = body.classList.contains('hidden');
      if (isHidden) {
        body.classList.remove('hidden');
        item?.classList.add('active');
        if (icon) icon.style.transform = 'rotate(180deg)';
      } else {
        body.classList.add('hidden');
        item?.classList.remove('active');
        if (icon) icon.style.transform = 'rotate(0deg)';
      }
    });
  });
</script>
