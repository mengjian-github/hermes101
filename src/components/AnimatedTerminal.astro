---
---
<div class="bg-[#1e1e1e] rounded-2xl p-7 text-[#e5e5e5]">
  <div class="flex gap-2 mb-5">
    <span class="w-3 h-3 rounded-full bg-[#ff5f56]"></span>
    <span class="w-3 h-3 rounded-full bg-[#ffbd2e]"></span>
    <span class="w-3 h-3 rounded-full bg-[#27c93f]"></span>
  </div>
  <div id="terminal-content" style="font-family: 'Geist Mono', ui-monospace, monospace; font-size: 15px; line-height: 1.8;">
  </div>
</div>

<script is:inline>
  (function() {
    var el = document.getElementById('terminal-content');
    if (!el) return;

    var lines = [
      { text: '$ curl -fsSL https://raw.githubusercontent.com/.../install.sh | bash', delay: 40, pause: 600 },
      { text: 'Installing Hermes Agent...', delay: 25, pause: 400 },
      { text: '✓ Installation complete!', delay: 25, pause: 800 },
      { text: '', delay: 0, pause: 300 },
      { text: '$ hermes doctor', delay: 50, pause: 600 },
      { text: '✓ All systems operational', delay: 25, pause: 800 },
      { text: '', delay: 0, pause: 300 },
      { text: '$ hermes', delay: 50, pause: 600 },
      { text: "Hello! I'm your Hermes Agent. How can I help?", delay: 25, pause: 2000 },
    ];

    var lineHeight = 1.8;
    var fontSize = 15;
    var pxPerLine = fontSize * lineHeight;

    function typeLine(line, container) {
      return new Promise(function(resolve) {
        var lineEl = document.createElement('div');
        lineEl.style.minHeight = pxPerLine + 'px';

        // Color $ prompt green
        if (line.text.startsWith('$')) {
          var promptSpan = document.createElement('span');
          promptSpan.style.color = '#18E299';
          promptSpan.textContent = '$ ';
          lineEl.appendChild(promptSpan);

          var restSpan = document.createElement('span');
          restSpan.style.color = '#e5e5e5';
          lineEl.appendChild(restSpan);

          var rest = line.text.substring(2);
          var i = 0;
          var interval = setInterval(function() {
            restSpan.textContent += rest[i];
            i++;
            if (i >= rest.length) {
              clearInterval(interval);
              setTimeout(resolve, line.pause);
            }
          }, line.delay);
        } else if (line.text.startsWith('✓')) {
          lineEl.style.color = '#18E299';
          lineEl.textContent = line.text;
          setTimeout(resolve, line.pause);
        } else if (line.text === '') {
          lineEl.innerHTML = '&nbsp;';
          setTimeout(resolve, line.pause);
        } else {
          lineEl.style.color = '#888';
          lineEl.textContent = line.text;
          setTimeout(resolve, line.pause);
        }

        container.appendChild(lineEl);
      });
    }

    function clearLines(container) {
      return new Promise(function(resolve) {
        container.style.transition = 'opacity 0.3s';
        container.style.opacity = '0';
        setTimeout(function() {
          container.innerHTML = '';
          container.style.opacity = '1';
          resolve();
        }, 300);
      });
    }

    async function loop() {
      for (var i = 0; i < lines.length; i++) {
        await typeLine(lines[i], el);
      }
      await clearLines(el);
      await new Promise(function(r) { setTimeout(r, 500); });
      loop();
    }

    // Start after a brief delay
    setTimeout(loop, 800);
  })();
</script>
