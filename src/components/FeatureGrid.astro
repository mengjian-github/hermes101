---
export interface Feature {
  icon: string;
  title: string;
  desc: string;
}
export interface Props {
  features: Feature[];
}
const { features } = Astro.props;
---
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
  {features.map((f, i) => (
    <div class="card group"
         style={`animation-delay: ${i * 50}ms;`}>
      <div class="w-11 h-11 rounded-xl flex items-center justify-center text-xl mb-5"
           style="background: var(--brand-glow);">
        {f.icon}
      </div>
      <h3 class="text-[16px] font-semibold mb-2" style="color: var(--text);">{f.title}</h3>
      <p class="text-sm leading-relaxed" style="color: var(--text-muted);">{f.desc}</p>
    </div>
  ))}
</div>
