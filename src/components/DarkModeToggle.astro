---
---
<button id="dark-mode-toggle" type="button" aria-label="切换主题"
  class="relative w-9 h-9 flex items-center justify-center rounded-lg hover:bg-[var(--surface)] transition-colors cursor-pointer">
  <!-- Sun icon (shown in dark mode) -->
  <svg class="sun-icon w-[18px] h-[18px] text-[var(--text-secondary)] dark:block hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="5"></circle>
    <line x1="12" y1="1" x2="12" y2="3"></line>
    <line x1="12" y1="21" x2="12" y2="23"></line>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
    <line x1="1" y1="12" x2="3" y2="12"></line>
    <line x1="21" y1="12" x2="23" y2="12"></line>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
  </svg>
  <!-- Moon icon (shown in light mode) -->
  <svg class="moon-icon w-[18px] h-[18px] text-[var(--text-secondary)] dark:hidden block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>
<script>
  const toggle = document.getElementById('dark-mode-toggle');
  if (toggle) {
    toggle.addEventListener('click', () => {
      const html = document.documentElement;
      const isDark = html.classList.contains('dark');
      // Add transitioning class for smooth switch
      html.classList.add('transitioning');
      html.classList.toggle('dark', !isDark);
      localStorage.setItem('theme', isDark ? 'light' : 'dark');
      // Remove transitioning after animation
      setTimeout(() => html.classList.remove('transitioning'), 250);
    });
  }
</script>
