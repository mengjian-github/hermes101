---
const year = new Date().getFullYear();
---
<footer class="w-full py-12 bg-[#0A0A0F] border-t border-white/[0.05]">
  <div class="flex flex-col md:flex-row justify-between items-center px-8 max-w-7xl mx-auto">
    <div class="mb-8 md:mb-0">
      <a href="/" class="text-[#18E299] font-bold text-xl">Hermes Agent</a>
      <p class="text-white/40 text-sm mt-2 tracking-tight">© {year} Hermes Agent. All rights reserved.</p>
    </div>
    <div class="flex gap-8">
      <a class="text-white/40 text-sm hover:text-white transition-colors" href="/faq">常见问题</a>
      <a class="text-white/40 text-sm hover:text-white transition-colors" href="https://github.com" target="_blank">GitHub</a>
      <a class="text-white/40 text-sm hover:text-white transition-colors" href="/migrate">迁移指南</a>
    </div>
  </div>
</footer>
