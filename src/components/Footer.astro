      <!-- Community -->
      <div>
        <h4 class="text-sm font-semibold text-[#e8e8f0] mb-4">社区</h4>
        <div class="flex flex-col gap-2.5">
          <a href="https://github.com/NousResearch/hermes-agent" target="_blank" rel="noopener" class="text-sm hover:text-[#18E299] transition-colors" style="color: #6a6a82;">GitHub</a>
          <a href="https://github.com/NousResearch/hermes-agent/discussions" target="_blank" rel="noopener" class="text-sm hover:text-[#18E299] transition-colors" style="color: #6a6a82;">Discussions</a>
          <a href="#" class="text-sm hover:text-[#18E299] transition-colors" style="color: #6a6a82;">Telegram 群组</a>
          <a href="#" class="text-sm hover:text-[#18E299] transition-colors" style="color: #6a6a82;">Discord</a>
        </div>
      </div>
    </div>

