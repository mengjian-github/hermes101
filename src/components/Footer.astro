    <div class="mt-12 pt-8 border-t" style="border-color: rgba(255,255,255,0.06);">
      <div class="flex flex-col md:flex-row items-center justify-between gap-3">
        <p class="text-xs" style="color: #4a4a6a;">© 2026 hermes101.site · 社区独立指南，非 Nous Research 官方文档</p>
        <p class="text-xs" style="color: #4a4a6a;">基于 Hermes v0.9.x · 最后更新 2026-04-15</p>
      </div>
    </div>
  </div>
