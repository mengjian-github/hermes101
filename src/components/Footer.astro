<footer style="background: #06060a; color: #a0a0b8;" class="mt-auto">
  <div class="max-w-[1200px] mx-auto px-6 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- Brand -->
      <div>
        <span class="font-display text-lg font-semibold tracking-[-0.3px] text-[#e8e8f0] flex items-center gap-1.5">
          <span class="inline-block w-2 h-2 rounded-full bg-[#18E299]"></span>
          hermes101
        </span>
        <p class="text-sm mt-3 leading-relaxed" style="color: #6a6a82;">
          Hermes Agent 中文入门指南。<br/>
          5 分钟安装，7 天掌握。
        </p>
      </div>

      <!-- Navigation -->
      <div>
        <h4 class="text-sm font-semibold text-[#e8e8f0] mb-4">导航</h4>
        <div class="flex flex-col gap-2.5">
          <a href="/setup" class="text-sm hover:text-[#18E299] transition-colors" style="color: #6a6a82;">安装指南</a>
          <a href="/7-days" class="text-sm hover:text-[#18E299] transition-colors" style="color: #6a6a82;">7 天教程</a>
