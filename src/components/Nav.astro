---
interface Props {
  lang?: 'en' | 'zh-CN';
}

const { lang = 'en' } = Astro.props;
const currentPath = Astro.url.pathname;
const isZh = lang === 'zh-CN';
const prefix = isZh ? '/zh' : '';
const labels = isZh
  ? {
      home: '首页',
      setup: '安装',
      days: '7天教程',
      resources: '资源',
      migrate: '迁移',
      faq: 'FAQ',
      cta: '开始安装',
      switch: 'English',
    }
  : {
      home: 'Home',
      setup: 'Install',
      days: '7-Day Guide',
      resources: 'Resources',
      migrate: 'Migrate',
      faq: 'FAQ',
      cta: 'Start',
      switch: '中文',
    };
const links = isZh
  ? [
      { href: `${prefix}/`, label: labels.home },
      { href: `${prefix}/setup`, label: labels.setup },
      { href: `${prefix}/7-days`, label: labels.days },
      { href: `${prefix}/resources`, label: labels.resources },
      { href: `${prefix}/migrate`, label: labels.migrate },
      { href: `${prefix}/faq`, label: labels.faq },
    ]
  : [
      { href: `${prefix}/quickstart`, label: 'Quickstart' },
      { href: `${prefix}/setup`, label: labels.setup },
      { href: `${prefix}/7-days`, label: labels.days },
      { href: `${prefix}/faq`, label: labels.faq },
      { href: 'https://hermes-agent.nousresearch.com/docs', label: 'Official Docs' },
      { href: `${prefix}/zh/`, label: '中文' },
    ];
const normalize = (path: string) => path.endsWith('/') && path !== '/' ? path.slice(0, -1) : path;
const zhFallbackByPath: Record<string, string> = {
  '/': '/zh/',
  '/quickstart': '/zh/setup',
  '/setup': '/zh/setup',
  '/7-days': '/zh/7-days',
  '/faq': '/zh/faq',
};
const enFallbackByPath: Record<string, string> = {
  '/zh/': '/',
  '/zh/setup': '/setup',
  '/zh/7-days': '/7-days',
  '/zh/faq': '/faq',
  '/zh/migrate': '/setup',
  '/zh/resources': '/7-days',
};
const normalizedCurrent = normalize(currentPath);
const switchHref = isZh
  ? (enFallbackByPath[normalizedCurrent] || '/')
  : (zhFallbackByPath[normalizedCurrent] || '/zh/');
---
<header class="fixed top-0 w-full z-50 bg-[#0A0A0F]/80 backdrop-blur-xl border-b border-white/[0.05]">
  <div class="flex justify-between items-center px-6 py-4 max-w-6xl mx-auto">
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-[#18E299]" style="font-variation-settings: 'FILL' 1;">terminal</span>
      <a href={isZh ? '/zh/' : '/'} class="text-xl md:text-2xl font-black text-white italic tracking-[-0.04em]">Hermes Agent</a>
    </div>
    <nav class="hidden md:flex items-center gap-8">
      {links.map(link => (
        <a
          href={link.href}
          class:list={[
            "font-medium text-sm transition-all duration-300 min-h-[44px] flex items-center px-2",
            normalize(currentPath) === normalize(link.href)
              ? "text-[#18E299] font-bold"
              : "text-white/60 hover:text-[#51FFB4]"
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <a href={switchHref}
         hreflang={isZh ? 'en' : 'zh-CN'}
         class="hidden sm:inline-flex px-4 py-2 rounded-full border border-white/10 text-white/70 text-sm font-bold hover:text-[#18E299] hover:border-[#18E299]/40 transition-all min-h-[44px] items-center justify-center">
        {isZh ? labels.switch : '中文'}
      </a>
      <a href={`${prefix}/setup`}
         class="bg-white text-[#0A0A0F] px-4 md:px-6 py-2 rounded-full font-bold hover:bg-[#18E299] hover:text-[#003823] transition-all duration-300 text-sm min-h-[44px] flex items-center justify-center">
        {isZh ? labels.cta : 'Start'}
      </a>
      <button id="mobile-menu-btn" class="md:hidden text-white/60 hover:text-white active:text-white active:scale-95 transition-transform min-w-[44px] min-h-[44px] flex items-center justify-center" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <span class="material-symbols-outlined">menu</span>
      </button>
    </div>
  </div>
  <div id="mobile-menu" class="hidden md:hidden border-t border-white/[0.05]">
    <nav class="flex flex-col px-6 py-4 gap-4">
      {links.map(link => (
        <a
          href={link.href}
          class:list={[
            "font-medium text-sm py-3 px-2 min-h-[44px] min-w-[44px] flex items-center",
            normalize(currentPath) === normalize(link.href)
              ? "text-[#18E299] font-bold"
              : "text-white/60"
          ]}
        >
          {link.label}
        </a>
      ))}
      <a href={switchHref} hreflang={isZh ? 'en' : 'zh-CN'} class="font-medium text-sm py-3 px-2 min-h-[44px] min-w-[44px] flex items-center text-white/60">{labels.switch}</a>
    </nav>
  </div>
</header>

<script is:inline>
  (function() {
    var btn = document.getElementById('mobile-menu-btn');
    var menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    btn.addEventListener('click', function() {
      var isOpen = menu.classList.contains('hidden');
      menu.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      btn.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
    });
  })();
</script>
