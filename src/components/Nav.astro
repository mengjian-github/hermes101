---
const currentPath = Astro.url.pathname;
const links = [
  { href: "/", label: "首页" },
  { href: "/setup", label: "安装" },
  { href: "/7-days", label: "7天教程" },
  { href: "/resources", label: "资源" },
  { href: "/migrate", label: "迁移" },
  { href: "/faq", label: "FAQ" },
];
---
<header class="fixed top-0 w-full z-50 bg-[#0A0A0F]/80 backdrop-blur-xl border-b border-white/[0.05]">
  <div class="flex justify-between items-center px-6 py-4 max-w-6xl mx-auto">
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-[#18E299]" style="font-variation-settings: 'FILL' 1;">terminal</span>
      <a href="/" class="text-2xl font-black text-white italic tracking-[-0.04em]">Hermes Agent</a>
    </div>
    <nav class="hidden md:flex items-center gap-8">
      {links.map(link => (
        <a
          href={link.href}
          class:list={[
            "font-medium text-sm transition-all duration-300",
            currentPath === link.href
              ? "text-[#18E299] font-bold"
              : "text-white/60 hover:text-[#51FFB4]"
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-4">
      <a href="/setup"
         class="bg-white text-[#0A0A0F] px-6 py-2 rounded-full font-bold hover:bg-[#18E299] hover:text-[#003823] transition-all duration-300 text-sm">
        开始安装
      </a>
      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" class="md:hidden text-white/60 hover:text-white">
        <span class="material-symbols-outlined">menu</span>
      </button>
    </div>
  </div>
  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-white/[0.05]">
    <nav class="flex flex-col px-6 py-4 gap-4">
      {links.map(link => (
        <a
          href={link.href}
          class:list={[
            "font-medium text-sm py-2",
            currentPath === link.href
              ? "text-[#18E299] font-bold"
              : "text-white/60"
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script is:inline>
  document.getElementById('mobile-menu-btn')?.addEventListener('click', function() {
    document.getElementById('mobile-menu')?.classList.toggle('hidden');
  });
</script>
