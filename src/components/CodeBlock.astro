---
export interface Props {
  code: string;
  lang?: string;
}
const { code, lang = 'bash' } = Astro.props;
---
<div class="code-block relative group rounded-2xl overflow-hidden" style="background: #1e1e1e;">
  <!-- Floating copy button -->
  <button class="copy-btn absolute top-3 right-3 flex items-center gap-1.5 text-[12px] px-2.5 py-1.5 rounded-lg transition-colors hover:text-[#18E299] cursor-pointer opacity-0 group-hover:opacity-100"
          style="color: #888; background: rgba(255,255,255,0.08);" data-code={code}>
    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
    <span class="copy-text">复制</span>
  </button>
  <!-- Code area -->
  <div class="px-5 py-4 overflow-x-auto">
    <pre class="text-sm leading-relaxed m-0" style="font-family: 'Geist Mono', monospace; color: #e5e5e5;"><code set:html={code.replace(/^\$\s/gm, '<span style="color: #18E299;">$</span> ')} /></pre>
  </div>
</div>
<script>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const code = btn.dataset.code || '';
      try {
        await navigator.clipboard.writeText(code);
        const textEl = btn.querySelector('.copy-text');
        const original = textEl?.textContent || '';
        if (textEl) textEl.textContent = '✓ 已复制';
        btn.style.color = '#18E299';
        setTimeout(() => {
          if (textEl) textEl.textContent = original;
          btn.style.color = '';
        }, 1500);
      } catch {}
    });
  });
</script>
