---
export interface Props { text: string; }
const { text } = Astro.props;
---
<div class="bg-[rgba(24,226,153,0.15)] border border-[var(--brand)] rounded-xl px-6 py-[18px] mt-5 flex items-center gap-3.5">
  <span class="text-2xl">👍</span>
  <span class="text-base font-medium text-[#51FFB4]">{text}</span>
</div>
