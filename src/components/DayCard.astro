---
export interface Props { day: string; title: string; result: string; id: string; }
const { day, title, result, id } = Astro.props;
---
<div class="day-section relative bg-white border border-white/[0.06] rounded-2xl p-7 mb-6 scroll-mt-24" id={id}>
  <div class="day-check absolute right-6 top-7 w-[22px] h-[22px] border-2 border-white/[0.06] rounded-md cursor-pointer flex items-center justify-center text-white text-[13px] transition-all" data-day-check={id}></div>
  <div class="flex items-center gap-3 mb-3">
    <span class="bg-[var(--brand)] text-[#003823] px-3 py-1 rounded-full text-[13px] font-semibold">{day}</span>
    <h3 class="text-xl font-semibold">{title}</h3>
  </div>
  <div class="inline-flex items-center gap-2 bg-[rgba(24,226,153,0.15)] text-[#51FFB4] px-3.5 py-2 rounded-lg text-[13px] font-medium mb-4">
    成果：{result}
  </div>
  <div class="text-[15px] text-[#BACBBE] leading-relaxed">
    <slot />
  </div>
</div>
<script>
  (function() {
    document.querySelectorAll('.day-check').forEach((el) => {
      const id = el.dataset.dayCheck;
      if (!id) return;
      const key = 'day:' + id;
      const saved = localStorage.getItem(key) === '1';
      function render(checked) {
        if (checked) {
          el.classList.add('bg-[var(--brand)]', 'border-[var(--brand)]');
          el.textContent = '✓';
          if (el.parentElement) el.parentElement.classList.add('border-l-4', 'border-l-[#18E299]');
        } else {
          el.classList.remove('bg-[var(--brand)]', 'border-[var(--brand)]');
          el.textContent = '';
          if (el.parentElement) el.parentElement.classList.remove('border-l-4', 'border-l-[#18E299]');
        }
      }
      render(saved);
      el.addEventListener('click', () => {
        const current = localStorage.getItem(key) === '1';
        const next = !current;
        localStorage.setItem(key, next ? '1' : '0');
        render(next);
        window.dispatchEvent(new CustomEvent('day-progress-update'));
      });
    });
  })();
</script>
