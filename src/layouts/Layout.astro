---
import '../styles/global.css';
export interface Props {
  title: string;
  description: string;
  schema?: object;
  lang?: 'en' | 'zh-CN';
  canonicalPath?: string;
  hasAlternate?: boolean;
  noindex?: boolean;
}
const { title, description, schema, lang = 'en', canonicalPath, hasAlternate = false, noindex = false } = Astro.props;
const path = canonicalPath || Astro.url.pathname;
const normalizedPath = path.endsWith('/') ? path : `${path}/`;
const canonical = new URL(normalizedPath, Astro.site).toString();
const isZh = normalizedPath === '/zh/' || normalizedPath.startsWith('/zh/');
const pairedPath = isZh ? normalizedPath.replace(/^\/zh/, '') || '/' : `/zh${normalizedPath}`;
const localizedPaths = new Set([
  '/',
  '/setup/',
  '/7-days/',
  '/7-days/day-1/',
  '/7-days/day-2/',
  '/7-days/day-3/',
  '/7-days/day-4/',
  '/7-days/day-5/',
  '/7-days/day-6/',
  '/7-days/day-7/',
  '/resources/',
  '/migrate/',
  '/faq/',
]);
const rootPath = isZh ? (normalizedPath.replace(/^\/zh/, '') || '/') : normalizedPath;
const hasLocalizedPair = hasAlternate || localizedPaths.has(rootPath);
const alternates = hasLocalizedPair ? [
  { lang: 'en', href: new URL(isZh ? pairedPath : normalizedPath, Astro.site).toString() },
  { lang: 'zh-CN', href: new URL(isZh ? normalizedPath : pairedPath, Astro.site).toString() },
  { lang: 'x-default', href: new URL(isZh ? pairedPath : normalizedPath, Astro.site).toString() },
] : [
  { lang: 'x-default', href: canonical },
];
// Public analytics identifiers for the dedicated hermes101.dev properties.
// Env overrides keep preview/staging flexible, but production deploys should not
// silently drop analytics if Cloudflare Pages build env vars are unavailable.
const ga4MeasurementId = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID || 'G-FDGWTRC2MF';
const clarityProjectId = import.meta.env.PUBLIC_CLARITY_PROJECT_ID || 'x1tz4iudu9';
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN || 'hermes101.dev';
const plausibleHost = (import.meta.env.PUBLIC_PLAUSIBLE_HOST || 'https://plausible.shipsolo.io').replace(/\/$/, '');
---
<!DOCTYPE html>
<html lang={lang} class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="ahrefs-site-verification" content="fe83b6f67d746fead071d19f28161c6e8c39cc6daa572d4f886a36b52fe204c1" />
  {noindex && <meta name="robots" content="noindex,follow" />}
  <link rel="canonical" href={canonical} />
  {alternates.map((alternate) => (
    <link rel="alternate" hreflang={alternate.lang} href={alternate.href} />
  ))}
  <link rel="sitemap" href="/sitemap-index.xml" />

  <!-- Fonts: Inter + Geist Mono + Material Symbols -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

  <!-- OG Image -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/og-image.png', Astro.site).toString()} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL('/og-image.png', Astro.site).toString()} />

  <!-- Paid-readiness analytics: IDs are injected at build time; no ad accounts or spend are mutated. -->
  {ga4MeasurementId && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4MeasurementId}`}></script>
      <script is:inline define:vars={{ ga4MeasurementId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = window.gtag || gtag;
        gtag('js', new Date());
        gtag('config', ga4MeasurementId, { send_page_view: true });
      </script>
    </>
  )}
  {plausibleDomain && (
    <script defer data-domain={plausibleDomain} src={`${plausibleHost}/js/script.tagged-events.js`}></script>
  )}
  {clarityProjectId && (
    <script is:inline define:vars={{ clarityProjectId }}>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", clarityProjectId);
    </script>
  )}

  <!-- Schema.org -->
  {schema && (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  )}
</head>
<body class="antialiased">
  <slot />

  <!-- Global fade-in-up observer -->
  <script is:inline>
  try {
    (function() {
      const observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('.fade-in-up').forEach(function(el) {
        observer.observe(el);
      });
    })();

    // Accordion toggle (FAQ page)
    document.querySelectorAll('.accordion-header').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var item = btn.closest('.accordion-item');
        if (!item) return;
        var body = item.querySelector('.accordion-body');
        var icon = btn.querySelector('.accordion-icon');
        var willOpen = body && body.classList.contains('hidden');
        if (body) body.classList.toggle('hidden');
        if (icon) icon.style.transform = (body && !body.classList.contains('hidden')) ? 'rotate(180deg)' : '';
        if (willOpen && window.hermes101Analytics && typeof window.hermes101Analytics.track === 'function') {
          window.hermes101Analytics.track('faq_expand', {
            page_location: window.location.href,
            page_path: window.location.pathname,
            question: btn.textContent ? btn.textContent.trim().replace(/\s+/g, ' ').slice(0, 160) : ''
          });
        }
      });
    });

    // Checklist toggle (migrate/setup pages)
    function updateChecklistCounts() {
      var preCount = document.getElementById('pre-count');
      var postCount = document.getElementById('post-count');
      if (preCount) {
        var checked = document.querySelectorAll('#pre-checklist .check-box[data-checked="true"]').length;
        var total = document.querySelectorAll('#pre-checklist .check-item').length;
        preCount.textContent = checked + ' / ' + total;
      }
      if (postCount) {
        var checked = document.querySelectorAll('#post-checklist .check-box[data-checked="true"]').length;
        var total = document.querySelectorAll('#post-checklist .check-item').length;
        postCount.textContent = checked + ' / ' + total;
      }
    }
    document.querySelectorAll('.check-item').forEach(function(item) {
      item.addEventListener('click', function() {
        var box = item.querySelector('.check-box');
        if (!box) return;
        var text = item.querySelector('.check-text');
        var checked = box.dataset.checked === 'true';
        box.dataset.checked = checked ? 'false' : 'true';
        box.classList.toggle('checked', !checked);
        if (!checked) {
          box.style.background = 'var(--brand)';
          box.style.borderColor = 'var(--brand)';
          box.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="white"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>';
          item.style.opacity = '0.6';
          if (text) text.style.textDecoration = 'line-through';
        } else {
          box.style.background = '';
          box.style.borderColor = '';
          box.innerHTML = '';
          item.style.opacity = '';
          if (text) text.style.textDecoration = '';
        }
        updateChecklistCounts();
        if (window.hermes101Analytics && typeof window.hermes101Analytics.track === 'function') {
          var label = item.textContent ? item.textContent.trim().replace(/\s+/g, ' ').slice(0, 160) : '';
          window.hermes101Analytics.track('setup_check_item_toggle', {
            page_location: window.location.href,
            page_path: window.location.pathname,
            checked: !checked,
            item_label: label
          });
          var allItems = Array.prototype.slice.call(document.querySelectorAll('.check-item .check-box'));
          if (allItems.length && allItems.every(function(candidate) { return candidate.dataset.checked === 'true'; })) {
            window.hermes101Analytics.track('setup_checklist_complete', {
              page_location: window.location.href,
              page_path: window.location.pathname,
              checked_items: allItems.length
            });
          }
        }
      });
    });

    // Explicit setup success CTA: gives users feedback and creates a non-payment North Star signal.
    document.querySelectorAll('[data-setup-success]').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var label = btn.dataset.successLabel || 'First chat verified';
        if (window.hermes101Analytics && typeof window.hermes101Analytics.track === 'function') {
          window.hermes101Analytics.track('setup_success_click', {
            page_location: window.location.href,
            page_path: window.location.pathname,
            success_label: label
          });
        }
        var target = btn.closest('[data-success-panel]') || btn;
        var existing = target.querySelector('[data-success-feedback]');
        if (!existing) {
          var feedback = document.createElement('p');
          feedback.setAttribute('data-success-feedback', 'true');
          feedback.className = 'mt-3 text-sm font-bold text-[#51FFB4]';
          feedback.textContent = 'Saved as setup success. Next: pick one 7-day lesson or open the official docs.';
          target.appendChild(feedback);
        }
      });
    });

    // Copy buttons
    document.querySelectorAll('.copy-btn').forEach(function(btn) {
      if (btn.tagName.toLowerCase() === 'button' && !btn.getAttribute('type')) btn.setAttribute('type', 'button');
      if (!btn.getAttribute('aria-label')) btn.setAttribute('aria-label', 'Copy command');
      if (!btn.getAttribute('title')) btn.setAttribute('title', 'Copy to clipboard');
      if (!btn.dataset.originalHtml) btn.dataset.originalHtml = btn.innerHTML;
      if (!btn.dataset.originalAriaLabel) btn.dataset.originalAriaLabel = btn.getAttribute('aria-label') || 'Copy command';
      btn.setAttribute('aria-live', 'polite');
      btn.setAttribute('aria-atomic', 'true');

      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        if (btn._copying) return;
        btn._copying = true;
        var text = (btn.dataset.copy || btn.getAttribute('data-copy') || '').trim();
        if (!text) { btn._copying = false; return; }
        var isChineseLabel = /[\u3400-\u9fff]/.test(btn.dataset.originalAriaLabel || '');

        function inferCopyEvent() {
          if (btn.dataset.trackEvent) return btn.dataset.trackEvent;
          if (text.indexOf('install.sh') !== -1 || text.indexOf('install.ps1') !== -1) return 'install_command_copy';
          if (text.indexOf('hermes setup') === 0 || text.indexOf('hermes model') === 0) return 'setup_command_copy';
          if (text === 'hermes') return 'first_chat_command_copy';
          if (text.indexOf('provider/model') !== -1) return 'first_chat_prompt_copy';
          return 'command_copy';
        }

        var copyEvent = inferCopyEvent();

        function trackCopyResult(success, method) {
          try {
            if (window.hermes101Analytics && typeof window.hermes101Analytics.track === 'function') {
              window.hermes101Analytics.track(success ? copyEvent : 'command_copy_failed', {
                page_location: window.location.href,
                page_path: window.location.pathname,
                copied_text: text.slice(0, 200),
                copy_surface: btn.closest('section, article, main') ? 'content' : 'unknown',
                copy_success: success,
                copy_method: method,
                intended_event: copyEvent
              });
            }
          } catch (err) {
            if (window.console && console.error) console.error('copy tracking error', err);
          }
        }

        function showResult(iconText, label, color, success, method) {
          trackCopyResult(success, method);
          btn.innerHTML = '<span class="material-symbols-outlined text-sm" style="color:' + color + ';">' + iconText + '</span>';
          if (label) btn.setAttribute('aria-label', label);
          btn.style.opacity = '0.9';
          setTimeout(function() {
            btn.innerHTML = btn.dataset.originalHtml || '<span class="material-symbols-outlined text-sm">content_copy</span>';
            btn.setAttribute('aria-label', btn.dataset.originalAriaLabel || 'Copy command');
            btn.style.opacity = '';
            btn._copying = false;
          }, 1500);
        }

        function doCopy() {
          try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(text).then(function() {
                showResult('check', isChineseLabel ? '已复制' : 'Copied', '#51FFB4', true, 'clipboard');
              }).catch(function() { fallbackCopy(); });
            } else { fallbackCopy(); }
          } catch (err) {
            fallbackCopy();
          }
        }

        function fallbackCopy() {
          var ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('aria-hidden', 'true');
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          ta.style.pointerEvents = 'none';
          document.body.appendChild(ta);
          ta.select();
          try {
            if (document.execCommand('copy')) {
              showResult('check', isChineseLabel ? '已复制' : 'Copied', '#51FFB4', true, 'execCommand');
            } else { throw new Error('execCommand failed'); }
          } catch (err) {
            showResult('error', isChineseLabel ? '复制失败' : 'Copy failed', '#FFB962', false, 'execCommand');
            if (window.console && console.error) console.error('Copy failed:', err);
          }
          try { document.body.removeChild(ta); } catch (e) {}
        }

        doCopy();
      });
    });

    // Trouble accordion (migrate page - 常见失败场景)
    document.querySelectorAll('.trouble-header').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var item = btn.closest('.trouble-item');
        if (!item) return;
        var body = item.querySelector('.trouble-body');
        var arrow = btn.querySelector('.trouble-arrow');
        if (body) body.classList.toggle('hidden');
        if (arrow) arrow.style.transform = (body && !body.classList.contains('hidden')) ? 'rotate(180deg)' : '';
      });
    });

    // Paid-readiness event + UTM contract
    (function() {
      var UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'utm_id'];
      var storageKey = 'hermes101_utm_params';

      function pickUtms(searchParams) {
        var out = {};
        UTM_KEYS.forEach(function(key) {
          var value = searchParams.get(key);
          if (value) out[key] = value;
        });
        return out;
      }

      function getStoredUtms() {
        try { return JSON.parse(sessionStorage.getItem(storageKey) || '{}') || {}; }
        catch (e) { return {}; }
      }

      function currentUtms() {
        var fromUrl = pickUtms(new URLSearchParams(window.location.search));
        if (Object.keys(fromUrl).length) {
          try { sessionStorage.setItem(storageKey, JSON.stringify(fromUrl)); } catch (e) {}
          return fromUrl;
        }
        return getStoredUtms();
      }

      function decorateInternalLinks(utms) {
        if (!Object.keys(utms).length) return;
        document.querySelectorAll('a[href]').forEach(function(anchor) {
          var href = anchor.getAttribute('href');
          if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:')) return;
          var url;
          try { url = new URL(href, window.location.href); } catch (e) { return; }
          if (url.origin !== window.location.origin) return;
          Object.keys(utms).forEach(function(key) {
            if (!url.searchParams.has(key)) url.searchParams.set(key, utms[key]);
          });
          anchor.href = url.toString();
        });
      }

      function inferEvent(anchor) {
        if (anchor.dataset.trackEvent) return anchor.dataset.trackEvent;
        if (anchor.matches('[data-language-switch], [hreflang]')) return 'language_switch_click';
        var url;
        try { url = new URL(anchor.href, window.location.href); } catch (e) { return null; }
        if (anchor.dataset.productReferral === 'true') return 'product_referral_click';
        if (anchor.dataset.leadIntent === 'true') return 'lead_intent_click';
        if (url.hostname === 'github.com') return 'github_click';
        if (url.hostname === 'shipsolo.io' || url.hostname === 'ziliu.online') return 'product_referral_click';
        var normalizedPath = url.pathname.replace(/^\/zh(?=\/|$)/, '') || '/';
        if (normalizedPath.match(/^\/7-days\/day-\d+\/?$/)) return 'tutorial_day_click';
        if (normalizedPath.startsWith('/resources')) return 'resource_click';
        if (normalizedPath.startsWith('/setup')) return 'start_install_click';
        if (normalizedPath.startsWith('/quickstart')) return 'start_quickstart_click';
        if (normalizedPath === '/7-days/' || normalizedPath === '/7-days') return 'start_7days_click';
        if (anchor.closest('nav, footer') || normalizedPath.startsWith('/7-days') || normalizedPath.startsWith('/migrate') || normalizedPath.startsWith('/faq')) return 'doc_nav_click';
        return null;
      }

      function eventParams(anchor, extra) {
        var url;
        try { url = new URL(anchor && anchor.href ? anchor.href : window.location.href, window.location.href); }
        catch (e) { url = new URL(window.location.href); }
        return Object.assign({
          page_location: window.location.href,
          page_path: window.location.pathname,
          link_url: url.toString(),
          link_path: url.pathname,
          link_text: (anchor && anchor.textContent ? anchor.textContent.trim().replace(/\s+/g, ' ').slice(0, 120) : ''),
          outbound: url.origin !== window.location.origin
        }, currentUtms(), extra || {});
      }

      function track(name, params) {
        if (!name) return;
        var payload = params || {};
        window.__hermes101_events = window.__hermes101_events || [];
        window.__hermes101_events.push({ name: name, params: payload, ts: Date.now() });
        if (typeof window.gtag === 'function') window.gtag('event', name, payload);
        if (typeof window.plausible === 'function') window.plausible(name, { props: payload });
        if (typeof window.clarity === 'function') window.clarity('event', name);

        var conversionGoals = {
          product_referral_click: 'product_referral',
          lead_intent_click: 'guide_request',
          official_docs_click: 'official_docs_referral',
          install_command_copy: 'install_command_copy',
          setup_command_copy: 'setup_command_copy',
          first_chat_command_copy: 'first_chat_command_copy',
          first_chat_prompt_copy: 'first_chat_prompt_copy',
          start_quickstart_click: 'quickstart_start',
          start_install_click: 'install_start',
          start_7days_click: 'tutorial_path_start',
          next_day_click: 'tutorial_day_start',
          tutorial_day_click: 'tutorial_day_start',
          setup_success_click: 'setup_success',
          setup_checklist_complete: 'setup_checklist_complete'
        };
        if (conversionGoals[name]) {
          var goalPayload = Object.assign({}, payload, {
            goal_name: conversionGoals[name],
            source_event: name
          });
          window.__hermes101_events.push({ name: 'conversion_goal', params: goalPayload, ts: Date.now() });
          if (typeof window.gtag === 'function') window.gtag('event', 'conversion_goal', goalPayload);
          if (typeof window.plausible === 'function') window.plausible('conversion_goal', { props: goalPayload });
          if (typeof window.clarity === 'function') window.clarity('event', 'conversion_goal_' + conversionGoals[name]);
        }
      }


      var utms = currentUtms();
      decorateInternalLinks(utms);
      track('tutorial_page_view', Object.assign({
        page_location: window.location.href,
        page_path: window.location.pathname,
        page_title: document.title
      }, currentUtms()));
      document.addEventListener('click', function(event) {
        var anchor = event.target.closest && event.target.closest('a[href]');
        if (!anchor) return;
        var name = inferEvent(anchor);
        if (name) track(name, eventParams(anchor));
      }, true);
      var scrollMilestones = { 50: false, 90: false };
      window.addEventListener('scroll', function() {
        var doc = document.documentElement;
        var max = Math.max(1, doc.scrollHeight - window.innerHeight);
        var pct = Math.round((window.scrollY / max) * 100);
        [50, 90].forEach(function(mark) {
          if (!scrollMilestones[mark] && pct >= mark) {
            scrollMilestones[mark] = true;
            track('scroll_depth', {
              page_location: window.location.href,
              page_path: window.location.pathname,
              percent: mark
            });
          }
        });
      }, { passive: true });
      window.hermes101Analytics = { track: track, currentUtms: currentUtms, decorateInternalLinks: decorateInternalLinks };
    })();

    // Setup page tab switcher
    window.switchTab = function(tab) {
      if (window.hermes101Analytics && typeof window.hermes101Analytics.track === 'function') {
        window.hermes101Analytics.track('setup_tab_switch', {
          page_location: window.location.href,
          page_path: window.location.pathname,
          tab: tab
        });
      }
      var buttons = document.querySelectorAll('[data-tab]');
      buttons.forEach(function(b) {
        if (b.dataset.tab === tab) {
          b.className = 'pb-4 text-[#51ffb4] font-bold border-b-2 border-[#51ffb4] transition-all whitespace-nowrap';
        } else {
          b.className = 'pb-4 text-[#bacbbe] font-medium hover:text-white transition-all whitespace-nowrap';
        }
      });
      var panels = document.querySelectorAll('[data-panel]');
      panels.forEach(function(p) {
        if (p.dataset.panel === tab) {
          p.classList.remove('hidden');
        } else {
          p.classList.add('hidden');
        }
      });
    };
  } catch (e) { if (window.console && console.error) console.error('hermes101 global script error', e); }
  </script>
</body>
</html>
