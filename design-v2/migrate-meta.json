    "htmlContent": "<!DOCTYPE html>\n\n<html class=\"light\" lang=\"zh-CN\"><head>\n<meta charset=\"utf-8\"/>\n<meta content=\"width=device-width, initial-scale=1.0\" name=\"viewport\"/>\n<title>OpenClaw → Hermes Migration Guide</title>\n<script src=\"https://cdn.tailwindcss.com?plugins=forms,container-queries\"></script>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Geist+Mono:wght@400;500&amp;family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap\" rel=\"stylesheet\"/>\n<script id=\"tailwind-config\">\n        tailwind.config = {\n          darkMode: \"class\",\n          theme: {\n            extend: {\n              \"colors\": {\n                      \"error-container\": \"#ffdad6\",\n                      \"primary-fixed\": \"#4dffb3\",\n                      \"primary\": \"#006c47\",\n                      \"on-tertiary\": \"#ffffff\",\n                      \"primary-container\": \"#18e299\",\n                      \"surface-bright\": \"#f9f9f9\",\n                      \"outline\": \"#6b7b70\",\n                      \"on-tertiary-fixed\": \"#002116\",\n                      \"secondary-fixed\": \"#7bfab9\",\n                      \"outline-variant\": \"#bacbbe\",\n                      \"on-error\": \"#ffffff\",\n                      \"on-secondary-fixed\": \"#002112\",\n                      \"secondary\": \"#006c45\",\n                      \"on-secondary-container\": \"#00734a\",\n                      \"surface-container-highest\": \"#e2e2e2\",\n                      \"on-tertiary-fixed-variant\": \"#2c4d40\",\n                      \"surface-tint\": \"#006c47\",\n                      \"background\": \"#f9f9f9\",\n                      \"surface-container-lowest\": \"#ffffff\",\n                      \"inverse-primary\": \"#17e299\",\n                      \"surface-variant\": \"#e2e2e2\",\n                      \"on-surface-variant\": \"#3b4a41\",\n                      \"on-primary-fixed\": \"#002112\",\n                      \"secondary-container\": \"#7bfab9\",\n                      \"on-primary\": \"#ffffff\",\n                      \"tertiary-fixed-dim\": \"#aacfbe\",\n                      \"surface-dim\": \"#dadada\",\n                      \"on-secondary-fixed-variant\": \"#005233\",\n                      \"inverse-surface\": \"#2f3131\",\n                      \"on-surface\": \"#1a1c1c\",\n                      \"on-background\": \"#1a1c1c\",\n                      \"on-primary-container\": \"#005f3d\",\n                      \"inverse-on-surface\": \"#f0f1f1\",\n                      \"tertiary-fixed\": \"#c5ebd9\",\n                      \"surface\": \"#f9f9f9\",\n                      \"on-secondary\": \"#ffffff\",\n                      \"error\": \"#ba1a1a\",\n                      \"on-tertiary-container\": \"#38594c\",\n                      \"surface-container\": \"#eeeeee\",\n                      \"on-error-container\": \"#93000a\",\n                      \"surface-container-high\": \"#e8e8e8\",\n                      \"tertiary\": \"#436557\",\n                      \"secondary-fixed-dim\": \"#5ddd9f\",\n                      \"primary-fixed-dim\": \"#17e299\",\n                      \"on-primary-fixed-variant\": \"#005234\",\n                      \"tertiary-container\": \"#aacfbe\",\n                      \"surface-container-low\": \"#f3f3f3\"\n              },\n              \"borderRadius\": {\n                      \"DEFAULT\": \"0.25rem\",\n                      \"lg\": \"0.5rem\",\n                      \"xl\": \"0.75rem\",\n                      \"full\": \"9999px\"\n              },\n              \"fontFamily\": {\n                      \"headline\": [\"Inter\", \"sans-serif\"],\n                      \"body\": [\"Inter\", \"sans-serif\"],\n                      \"label\": [\"Inter\", \"sans-serif\"],\n                      \"mono\": [\"Geist Mono\", \"monospace\"]\n              }\n            },\n          },\n        }\n    </script>\n<style>\n        .material-symbols-outlined {\n            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;\n            vertical-align: middle;\n        }\n        body { font-family: 'Inter', sans-serif; }\n        .hero-gradient {\n            background: linear-gradient(135deg, #18e299 0%, #0fa76e 100%);\n        }\n    </style>\n<style>\n    body {\n      min-height: max(884px, 100dvh);\n    }\n  </style>\n  </head>\n<body class=\"bg-surface text-on-surface antialiased selection:bg-primary-container/30\">\n<!-- Top Navigation Shell -->\n<header class=\"fixed top-0 w-full z-50 bg-white/70 backdrop-blur-md shadow-[0px_10px_30px_rgba(15,167,110,0.08)] flex items-center px-4 h-16 w-full\">\n<div class=\"flex items-center gap-3\">\n<span class=\"material-symbols-outlined text-emerald-500\">arrow_back</span>\n<h1 class=\"font-['Inter'] font-semibold tracking-tight text-zinc-900 text-lg\">Hermes 101</h1>\n</div>\n</header>\n<main class=\"max-w-[430px] mx-auto pt-24 pb-32 px-5 min-h-screen\">\n<!-- Hero Section -->\n<section class=\"mb-12\">\n<span class=\"inline-block px-3 py-1 bg-tertiary-fixed text-on-tertiary-fixed text-[10px] font-bold uppercase tracking-widest rounded-full mb-4\">Migration Guide</span>\n<h2 class=\"text-[2.75rem] leading-[1.1] font-bold tracking-tight text-on-surface mb-4\">OpenClaw 迁移指南</h2>\n<p class=\"text-on-surface-variant text-lg leading-relaxed\">使用 <code class=\"font-mono bg-surface-container-high px-1.5 rounded\">hermes claw migrate</code> 一键迁移。配置不会丢。</p>\n</section>\n<!-- Timeline Section -->\n<section class=\"mb-12\">\n<div class=\"flex items-center justify-between relative px-2\">\n<!-- Connectors -->\n<div class=\"absolute top-4 left-0 w-full h-[2px] bg-surface-container-highest -z-10\"></div>\n<div class=\"absolute top-4 left-0 w-[50%] h-[2px] bg-primary-container -z-10\"></div>\n<!-- Step 1: Completed -->\n<div class=\"flex flex-col items-center gap-2\">\n<div class=\"w-8 h-8 rounded-full bg-primary-container flex items-center justify-center text-on-primary-container\">\n<span class=\"material-symbols-outlined text-[18px]\">check</span>\n</div>\n<span class=\"text-[11px] font-medium text-on-surface-variant tracking-wide\">迁移前</span>\n</div>\n<!-- Step 2: Active -->\n<div class=\"flex flex-col items-center gap-2\">\n<div class=\"w-8 h-8 rounded-full bg-primary-container border-4 border-white flex items-center justify-center ring-2 ring-primary-container\">\n<div class=\"w-2 h-2 rounded-full bg-white\"></div>\n</div>\n<span class=\"text-[11px] font-bold text-primary tracking-wide\">迁移中</span>\n</div>\n<!-- Step 3: Future -->\n<div class=\"flex flex-col items-center gap-2\">\n<div class=\"w-8 h-8 rounded-full bg-surface-container border-2 border-outline-variant flex items-center justify-center\">\n</div>\n<span class=\"text-[11px] font-medium text-outline tracking-wide\">迁移后</span>\n</div>\n</div>\n</section>\n<!-- Pre-Migration Checklist -->\n<section class=\"mb-12\">\n<div class=\"flex items-baseline justify-between mb-6\">\n<h3 class=\"text-xl font-semibold\">迁移前检查清单</h3>\n<span class=\"text-sm font-mono text-primary font-bold\">7 / 10</span>\n</div>\n<div class=\"grid grid-cols-1 gap-3\">\n<!-- Checked Item -->\n<div class=\"flex items-center gap-4 p-4 bg-primary-fixed/20 rounded-xl\">\n<div class=\"bg-primary-container p-1 rounded-md text-on-primary-container flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[16px]\" style=\"font-variation-settings: 'wght' 700\">check</span>\n</div>\n<span class=\"text-sm font-medium text-on-surface\">OpenClaw 版本 ≥ 2.4.0</span>\n</div>\n<div class=\"flex items-center gap-4 p-4 bg-primary-fixed/20 rounded-xl\">\n<div class=\"bg-primary-container p-1 rounded-md text-on-primary-container flex items-center justify-center\">\n<span class=\"material-symbols-outlined text-[16px]\" style=\"font-variation-settings: 'wght' 700\">check</span>\n</div>\n<span class=\"text-sm font-medium text-on-surface\">备份原有 config.json</span>\n</div>\n<!-- Unchecked Item -->\n<div class=\"flex items-center gap-4 p-4 bg-surface-container-low rounded-xl\">\n<div class=\"border-2 border-outline-variant w-6 h-6 rounded-md\"></div>\n<span class=\"text-sm font-medium text-on-surface-variant\">确认 API 密钥有效性</span>\n</div>\n<div class=\"flex items-center gap-4 p-4 bg-surface-container-low rounded-xl\">\n<div class=\"border-2 border-outline-variant w-6 h-6 rounded-md\"></div>\n<span class=\"text-sm font-medium text-on-surface-variant\">关闭当前正在运行的进程</span>\n</div>\n</div>\n</section>\n<!-- Command & Execution Block -->\n<section class=\"mb-12\">\n<div class=\"bg-surface-container-lowest p-6 rounded-2xl shadow-[0px_10px_30px_rgba(15,167,110,0.05)] overflow-hidden\">\n<div class=\"flex items-center justify-between mb-6\">\n<code class=\"font-mono text-primary text-sm font-semibold\">hermes claw migrate</code>\n<button class=\"flex items-center gap-1.5 px-3 py-1.5 bg-surface-container-low rounded-lg text-xs font-bold text-on-surface-variant active:scale-95 transition-transform\">\n<span class=\"material-symbols-outlined text-sm\">content_copy</span>\n                        复制\n                    </button>\n</div>\n<!-- Terminal Execution -->\n<div class=\"bg-surface p-5 rounded-xl border-l-4 border-primary-container font-mono text-[13px] leading-relaxed\">\n<div class=\"flex items-center gap-3 text-on-surface-variant mb-2\">\n<span class=\"material-symbols-outlined text-[14px]\">radio_button_unchecked</span>\n<span>正在读取 OpenClaw 配置...</span>\n</div>\n<div class=\"flex items-center gap-3 text-on-surface-variant mb-2\">\n<span class=\"material-symbols-outlined text-[14px]\">radio_button_unchecked</span>\n<span>正在迁移渠道设置...</span>\n</div>\n<div class=\"flex items-center gap-3 text-on-surface-variant mb-2\">\n<span class=\"material-symbols-outlined text-[14px]\">radio_button_unchecked</span>\n<span>正在迁移工具配置...</span>\n</div>\n<div class=\"flex items-center gap-3 text-primary mt-4 pt-4 border-t border-surface-container\">\n<span class=\"material-symbols-outlined text-[16px]\" style=\"font-variation-settings: 'FILL' 1\">check_circle</span>\n<span class=\"font-bold\">迁移完成！共迁移 12 项配置。</span>\n</div>\n</div>\n</div>\n</section>\n<!-- Troubleshooting Accordion -->\n<section class=\"mb-12\">\n<h3 class=\"text-xl font-semibold mb-6\">常见失败场景</h3>\n<div class=\"space-y-3\">\n<!-- Accordion 1 -->\n<div class=\"p-5 bg-surface-container-low rounded-xl flex items-center justify-between group cursor-pointer\">\n<div class=\"flex items-center gap-4\">\n<span class=\"material-symbols-outlined text-outline\">error_outline</span>\n<span class=\"text-sm font-semibold\">提示 \"claw 不存在\"</span>\n</div>\n<span class=\"material-symbols-outlined text-outline-variant group-hover:text-primary transition-colors\">expand_more</span>\n</div>\n<!-- Accordion 2 -->\n<div class=\"p-5 bg-surface-container-low rounded-xl flex items-center justify-between group cursor-pointer\">\n<div class=\"flex items-center gap-4\">\n<span class=\"material-symbols-outlined text-outline\">layers_clear</span>\n<span class=\"text-sm font-semibold\">渠道配置丢失</span>\n</div>\n<span class=\"material-symbols-outlined text-outline-variant group-hover:text-primary transition-colors\">expand_more</span>\n</div>\n<!-- Accordion 3 -->\n<div class=\"p-5 bg-surface-container-low rounded-xl flex items-center justify-between group cursor-pointer\">\n<div class=\"flex items-center gap-4\">\n<span class=\"material-symbols-outlined text-outline\">key_off</span>\n<span class=\"text-sm font-semibold\">API key 迁移后无法调用</span>\n</div>\n<span class=\"material-symbols-outlined text-outline-variant group-hover:text-primary transition-colors\">expand_more</span>\n</div>\n<!-- Accordion 4 -->\n<div class=\"p-5 bg-surface-container-low rounded-xl flex items-center justify-between group cursor-pointer\">\n<div class=\"flex items-center gap-4\">\n<span class=\"material-symbols-outlined text-outline\">pause_circle</span>\n<span class=\"text-sm font-semibold\">命令执行到一半卡住</span>\n</div>\n<span class=\"material-symbols-outlined text-outline-variant group-hover:text-primary transition-colors\">expand_more</span>\n</div>\n</div>\n</section>\n<!-- Post-Migration Checklist -->\n<section class=\"mb-12\">\n<h3 class=\"text-xl font-semibold mb-6\">迁移后验证清单</h3>\n<div class=\"grid grid-cols-1 gap-3\">\n<div class=\"flex items-center gap-4 p-4 bg-surface-container-low rounded-xl\">\n<div class=\"border-2 border-outline-variant w-6 h-6 rounded-md\"></div>\n<span class=\"text-sm font-medium text-on-surface-variant\">运行 hermes status 查看状态</span>\n</div>\n<div class=\"flex items-center gap-4 p-4 bg-surface-container-low rounded-xl\">\n<div class=\"border-2 border-outline-variant w-6 h-6 rounded-md\"></div>\n<span class=\"text-sm font-medium text-on-surface-variant\">验证所有渠道链接存活</span>\n</div>\n<div class=\"flex items-center gap-4 p-4 bg-surface-container-low rounded-xl\">\n<div class=\"border-2 border-outline-variant w-6 h-6 rounded-md\"></div>\n<span class=\"text-sm font-medium text-on-surface-variant\">测试环境变量加载</span>\n</div>\n</div>\n</section>\n<!-- Decorative Card with Image -->\n<section class=\"mb-8\">\n<div class=\"relative w-full h-48 rounded-2xl overflow-hidden shadow-lg\">\n<img class=\"w-full h-full object-cover\" data-alt=\"Abstract vibrant geometric composition with flowing mint green and forest green shapes on a clean white background with soft shadows\" src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBpBRcEuptukKxbUwd4XAGAysxd6brpF4Qq7pZ7RTIl4wgCtKDBG-lh-PhjWJv2BXfK_aq0y2568HUaXKA8THZ4BR13K2OyU7YqdEtgOlaF3khR3PAAQTvHqhk3N_0XLESzFAHzrD64J41ywD9IS4FxGehmeUwJmPvchWy4leQvsXvidY8KLUOoSWg2dKXJOr3V0W_VTuX8VKtkTi4f3ithNxFgV4zTOCDDnueM3BwhwoJOoVneashjgOXsu_4mIMOOEMRxck_-XaoW\"/>\n<div class=\"absolute inset-0 bg-gradient-to-t from-zinc-950/60 to-transparent flex items-end p-6\">\n<div>\n<p class=\"text-white text-xs font-bold uppercase tracking-wider mb-1\">PRO TIP</p>\n<p class=\"text-emerald-300 text-sm\">迁移完成后，旧版 OpenClaw 可以安全卸载以节省空间。</p>\n</div>\n</div>\n</div>\n</section>\n</main>\n<!-- Bottom Navigation Shell -->\n<nav class=\"fixed bottom-0 w-full z-50 rounded-t-2xl bg-white/70 backdrop-blur-md shadow-[0px_-10px_30px_rgba(15,167,110,0.05)] flex justify-around items-center h-20 pb-safe px-6 w-full\">\n<a class=\"flex flex-col items-center justify-center text-emerald-600 bg-emerald-50 rounded-xl px-4 py-1 transition-transform active:scale-90 duration-150\" href=\"#\">\n<span class=\"material-symbols-outlined\">map</span>\n<span class=\"font-['Inter'] text-[11px] font-medium tracking-wide uppercase mt-0.5\">Path</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-zinc-400 hover:text-emerald-500 transition-all active:scale-90 duration-150\" href=\"#\">\n<span class=\"material-symbols-outlined\">menu_book</span>\n<span class=\"font-['Inter'] text-[11px] font-medium tracking-wide uppercase mt-0.5\">Resources</span>\n</a>\n<a class=\"flex flex-col items-center justify-center text-zinc-400 hover:text-emerald-500 transition-all active:scale-90 duration-150\" href=\"#\">\n<span class=\"material-symbols-outlined\">person</span>\n<span class=\"font-['Inter'] text-[11px] font-medium tracking-wide uppercase mt-0.5\">Profile</span>\n</a>\n</nav>\n</body></html>"
